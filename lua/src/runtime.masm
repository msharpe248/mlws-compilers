    div I0, 2
    call rt$copylist (R0) -> (R2)
    call rt$setarr (R1, R2)
    call rt$rawset (R1, 0, 0.0, "n", I0, 0.0, null)
    ret R1
.endf

; ------------------------------------------------------------- for loops

.func rt$forzero
    call rt$rterror ("'for' step is zero")
    ret
.endf

.func rt$forerr(ref what, i64, f64, ref)
    call rt$typename (I0, F0, R1) -> (R2)
    strcat R3, "bad 'for' ", R0, " (number expected, got ", R2, ")"
    call rt$rterror (R3)
    ret
.endf

; An integer loop: (runs?, the limit as an integer, the iteration count).
.func rt$forprepi(i64 init, i64 step, i64, f64, ref) -> (i64, i64, i64)
    bnz I1, 1f
    call rt$forzero
1:  bnz R0, 2f
    mov I3, I2
    jmp 5f
2:  beq.r R0, 4n, 3f
    typeof I4, R0
    bne I4, 1, 29f
    call rt$str2num (R0) -> (I4, I2, F0, R1)
    bz I4, 29f
    mov R0, R1
    bz R0, 1b
3:  bne.f64 F0, F0, 9f
    blt I1, 0, 4f
    floor F1, F0
    bge.f64 F1, 9223372036854775808.0, 31f
    blt.f64 F1, -9223372036854775808.0, 9f
    cvt.i64.f64 I3, F1
    jmp 5f
31: mov I3, 9223372036854775807
    jmp 5f
4:  ceil F1, F0
    blt.f64 F1, -9223372036854775808.0, 41f
    bge.f64 F1, 9223372036854775808.0, 9f
    cvt.i64.f64 I3, F1
    jmp 5f
41: mov I3, -9223372036854775807
    dec I3
5:  blt I1, 0, 6f
    bgt I0, I3, 9f
    sub I4, I3, I0
    div.u64 I4, I4, I1
    ret 1, I3, I4
6:  blt I0, I3, 9f
    sub I4, I0, I3
    add I5, I1, 1
    neg I5
    add I5, 1
    div.u64 I4, I4, I5
    ret 1, I3, I4
9:  ret 0, 0, 0
29: call rt$forerr ("limit", I2, F0, R0)
    ret 0, 0, 0
.endf

; A loop whose values are only known at run time: an integer loop (the
; limit slot holds the iteration count) or a float loop.
.func rt$forprep(i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref, i64, f64, ref, i64, f64, ref)
    bnz R0, 5f
    bnz R2, 5f
    call rt$forprepi (I0, I2, I1, F1, R1) -> (I3, I4, I5)
    ret I3, I0, 0.0, null, I5, 0.0, null, I2, 0.0, null
5:  ; floats
    call rt$fornum ("initial value", I0, F0, R0) -> (F0)
    call rt$fornum ("limit", I1, F1, R1) -> (F1)
    call rt$fornum ("step", I2, F2, R2) -> (F2)
    bne.f64 F2, 0.0, 6f
    call rt$forzero
6:  blt.f64 F2, 0.0, 7f
    sle.f64 I3, F0, F1
    jmp 8f
7:  sge.f64 I3, F0, F1
8:  ret I3, 0, F0, 4n, 0, F1, 4n, 0, F2, 4n
.endf

.func rt$fornum(ref what, i64, f64, ref) -> f64
3:  bnz R1, 1f
    cvt.f64.i64 F0, I0
    ret F0
1:  beq.r R1, 4n, 2f
    typeof I1, R1
    bne I1, 1, 9f
    call rt$str2num (R1) -> (I1, I0, F0, R1)
    bz I1, 9f
    jmp 3b
2:  ret F0
9:  call rt$forerr (R0, I0, F0, R1)
    ret 0.0
.endf

; The next iteration of a run-time loop: (continue?, the value, the count).
.func rt$forloop(i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref, i64)
    bnz R0, 5f
    bz I1, 9f
    dec I1
    add I0, I2
    ret 1, I0, 0.0, null, I1
5:  add F0, F2
    blt.f64 F2, 0.0, 6f
    ble.f64 F0, F1, 7f
    jmp 9f
6:  bge.f64 F0, F1, 7f
9:  ret 0, I0, F0, R0, I1
7:  ret 1, 0, F0, 4n, 0
.endf

; ------------------------------------------------------ to-be-closed values

.func rt$checkclose(i64, f64, ref, ref name)
    beq.r R0, 1n, 9f
    beq.r R0, 2n, 9f
    call rt$getmm (I0, F0, R0, "__close") -> (I1, F1, R2)
    bne.r R2, 1n, 9f
    strcat R3, "variable '", R1, "' got a non-closable value"
    call rt$rterror (R3)
9:  ret
.endf

.func rt$close(i64, f64, ref, i64, f64, ref)
    beq.r R0, 1n, 9f
    beq.r R0, 2n, 9f
    call rt$getmm (I0, F0, R0, "__close") -> (I2, F2, R2)
    beq.r R2, 1n, 9f
    call rt$call2 (null, I2, F2, R2, I0, F0, R0, I1, F1, R1) -> (I3, I4, F4, R4)
9:  ret
.endf
