; ---------------------------------------------------------------------------
; The Lua runtime (lua/src/runtime.masm and lib.masm, compiled into
; mlws-vm-luac and copied into every output file).
;
; A Lua value is a triple (i64, f64, ref). The ref says what it is:
;   null         an integer, in the i64
;   4n           a float, in the f64
;   1n, 2n, 3n   nil, false, true
;   otherwise    a string, a table (Tab), a function (Fn) or a coroutine (Thread)
; (BigInt constants: no Lua value is a BigInt, so they never collide.)
;
; A list of values (arguments, results, a table's array part) has two words
; per value: the ref, then the i64 or (for anything but an integer) the f64.
;
; Lua functions are .func (i64, f64, ref) x params -> (i64 n, i64, f64, ref):
; the number of results and the first one; results 2..n are in @rt$mv.
; Fn.sig says how to call one: k (0..8) exact parameters; 100+k: k
; parameters and a list of the rest; 200: one list of everything; 300+k:
; the argument count, then k parameters.
; ---------------------------------------------------------------------------

.struct Tab
    arr: ref            ; the array part: values 1..n
    n: i64
    hm: ref             ; the hash part: map key -> index of the value word in hs
    hs: ref             ; [key ref, key word, value ref, value word] per slot
    meta: ref           ; metatable
    idx: ref            ; as a metatable: its __index (ref half), or null
    nidx: ref           ; its __newindex
    dead: i64           ; slots (after the pinned ones) whose value is nil
    pin: i64            ; leading slots that never move (_G's global names)
    hw: i64             ; words in hs (for the compiler's inline caches)
    hmshared: i64       ; hm is a shape (shared, never changed), not this table's own
    prot: i64           ; as a metatable: it has a __metatable field
    lib: i64            ; as a metatable: 1 it has __gc, 2 and 4 its __mode has
                        ; k and v (setmetatable leaves these to the library)
    wk: ref             ; a weak table's entries (Weak), or null
.ends

.struct Weak            ; a weak table's entries, out of reach of the
    mode: i64           ; compiler's inline caches: 1 weak keys, 2 weak values
    r: ref              ; key -> value that is a reference (weak.map mode)
    n: ref              ; key -> Box of a number (weak keys only)
    s: ref              ; a snapshot of the keys for next, two words each
                        ; (weak.ref for an object), or null
    si: ref             ; key -> its index in s (weak keys)
.ends

.struct Fn
    clo: ref
    sig: i64
    name: ref           ; built-in functions: the name for messages
.ends

.struct Box             ; a captured variable that is assigned
    i: i64
    f: f64
    r: ref
.ends

.struct LuaErr          ; a Lua error: its value
    i: i64
    f: f64
    r: ref
    trace: ref
.ends

.struct Thread          ; a coroutine
    co: ref             ; the VM coroutine (null for the main thread)
    fn: ref
    ei: i64             ; the error it died with, for coroutine.close
    ef: f64
    er: ref
    failed: i64
.ends

        .align 8
rt$G:       .zero 8     ; _G
rt$Ghs:     .zero 8     ; _G's hash slots (the pinned globals)
rt$P:       .zero 8     ; the primitives handed to the prelude
rt$env:     .zero 8     ; the main chunk's _ENV
rt$mv:      .zero 8     ; results after the first
rt$chunk:   .zero 8     ; the chunk name
rt$strmeta: .zero 8     ; the string metatable
rt$ids:     .zero 8     ; object -> number, for tostring
rt$nextid:  .i64 0
rt$cur:     .zero 8     ; the running Thread
rt$main:    .zero 8     ; the main Thread
rt$ipairs_aux: .zero 8
rt$next_fn: .zero 8
rt$setmt:   .zero 8     ; the library's setmetatable, for calls made inline
rt$fins:    .zero 8     ; tables marked for finalization -> 1 (weak keys)
rt$finq:    .zero 8     ; marked tables found dead, waiting for their __gc
rt$closing: .i64 0      ; the program is ending: running the finalizers left
rt$sqrt_fn: .zero 8     ; the library's math.sqrt, for calls made inline
rt$sitesfn: .zero 8     ; the program's call sites (p$sites), for rt$argwho
rt$sites:   .zero 8     ; masm line -> [arguments, method, name], made the first time
rt$qnames:  .zero 8     ; B$ function -> its name in the library ("string.rep")
rt$argc:    .i64 -1     ; the number of arguments rt$apply passed last
rt$argfn:   .zero 8     ; and the function it called
rt$stdout:  .zero 8     ; io.stdout, set by the prelude
rt$fmtslow: .zero 8     ; the prelude's string.format, for what B$str_format leaves
rt$start:   .i64 0
rt$shapes:  .zero 8     ; shape -> (key -> the shape with that key added)
rt$root:    .zero 8     ; the empty shape
rt$ctors:   .zero 8     ; the shape each table constructor makes

; Load the value at word i of list l into (di, df, dr); t is scratch.
.macro LOADV l, i, t, di, df, dr
    mov \dr, \l[\i]
    add \t, \i, 1
    ldv \di, \df, \l[\t]
.endm

; Store (si, sf, sr) at word i of list l.
.macro STOREV l, i, t, si, sf, sr
    mov \l[\i], \sr
    add \t, \i, 1
    bnz \sr, .Lf\@
    mov \l[\t], \si
    jmp .Ld\@
.Lf\@:
    mov \l[\t], \sf
.Ld\@:
.endm

; Make the value at word i of list l nil.
.macro KILLV l, i, t
    mov.r \l[\i], 1n
    add \t, \i, 1
    mov.f64 \l[\t], 0.0
.endm

; Append (si, sf, sr) to list l.
.macro PUSHV l, si, sf, sr
    bnz \sr, .Lf\@
    lpush \l, \sr, \si
    jmp .Ld\@
.Lf\@:
    lpush \l, \sr, \sf
.Ld\@:
.endm

; ------------------------------------------------------------------ startup

.func rt$init(ref chunk)
    mov @rt$chunk, R0
    new R1, Tab
    mnew R2
    mov R1->Tab.hm, R2
    lnew R3
    mov R1->Tab.hs, R3
    mov @rt$G, R1
    mov @rt$env, R1
    mov @rt$Ghs, R3
    new R4, Tab
    mov @rt$P, R4
    lnew R5, 128
    resize R5, 128
    mov @rt$mv, R5
    new R6, Tab
    mov @rt$strmeta, R6
    mnew R7
    mov @rt$ids, R7
    new R8, Thread
    mov @rt$main, R8
    mov @rt$cur, R8
    ncall "time.monotonic" -> (I0)
    mov @rt$start, I0
    ret
.endf


; Shapes. Tables whose string keys were added in the same order share one
; map from key to slot (Tab.hm with Tab.hmshared set), which is never
; changed: adding a key moves the table to the next shape, kept in
; @rt$shapes. A table with more than 16 slots, a key of another type, or
; whose slots are compacted gets a map of its own.
.func rt$init_shapes(i64 nctors)
    mnew R0
    mov @rt$shapes, R0
    mnew R1
    mov @rt$root, R1
    lnew R2, I0
    resize R2, I0
    mov @rt$ctors, R2
    ret
.endf

; The shape of m with key added at value word w.
.func rt$shape_add(ref m, ref key, i64 w) -> ref
    mov R3, @rt$shapes
    mget.r R4, R3, R0, null
    bnz R4, 1f
    mnew R4
    mset R3, R0, R4
1:  mget.r R5, R4, R1, null
    bnz R5, 9f
    mnew R6
    ncall "map.union" (R0, R6) -> (R5)
    mset R5, R1, I0
    mset R4, R1, R5
9:  ret R5
.endf

; A table constructor of constant string keys: t gets hash slots hs and
; the shape of the constructor at site, which it returns (for the site to
; keep).
.func rt$tmpl(ref t, ref hs, i64 site) -> ref
    mov R2, @rt$ctors
    mov R3, R2[I0]
    bnz R3, 5f
    mov R3, @rt$root
    len I1, R1
    mov I2, 0
1:  bge I2, I1, 4f
    mov R4, R1[I2]
    add I3, I2, 2
    call rt$shape_add (R3, R4, I3) -> (R3)
    add I2, 4
    jmp 1b
4:  mov R2[I0], R3
5:  mov R0->Tab.hm, R3
    mov R0->Tab.hmshared, 1
    mov R0->Tab.hs, R1
    len I1, R1
    mov R0->Tab.hw, I1
    mov I4, 0
    mov I2, 2
6:  bge I2, I1, 7f
    mov R5, R1[I2]
    bne.r R5, 1n, 61f
    inc I4
61: add I2, 4
    jmp 6b
7:  mov R0->Tab.dead, I4
    ret R3
.endf

; Give t a map of its own instead of a shape.
.func rt$ownmap(ref t) -> ref
    mov R1, R0->Tab.hm
    mov I0, R0->Tab.hmshared
    bz I0, 1f
    mnew R2
    ncall "map.union" (R1, R2) -> (R1)
    mov R0->Tab.hm, R1
    mov R0->Tab.hmshared, 0
1:  ret R1
.endf

; A global name with a fixed slot in _G (in the order the compiler numbers them).
.func rt$pin(ref name)
    mov R1, @rt$G
    mov R2, R1->Tab.hs
    len I0, R2
    add I1, I0, 2
    lpush R2, R0
    lpush R2, 0.0
    lpush.r R2, 1n
    lpush R2, 0.0
    add I3, I0, 4
    mov R1->Tab.hw, I3
    mov R3, R1->Tab.hm
    mset R3, R0, I1
    mov I2, R1->Tab.pin
    inc I2
    mov R1->Tab.pin, I2
    ret
.endf

; The library table _G[name], made if need be.
.func rt$deflib(ref name) -> ref
    mov R1, @rt$G
    call rt$rawget (R1, 0, 0.0, R0) -> (I0, F0, R2)
    bisa R2, Tab, 1f
    new R2, Tab
    call rt$rawset (R1, 0, 0.0, R0, 0, 0.0, R2)
1:  ret R2
.endf

; tab[name] = a built-in function.
.func rt$defn(ref tab, ref name, ref clo, i64 sig)
    new R3, Fn
    mov R3->Fn.clo, R2
    mov R3->Fn.sig, I0
    mov R3->Fn.name, R1
    call rt$rawset (R0, 0, 0.0, R1, 0, 0.0, R3)
    ret
.endf

.func rt$getfield(ref tab, ref name) -> (i64, f64, ref)
    call rt$rawget (R0, 0, 0.0, R1) -> (I0, F0, R2)
    ret I0, F0, R2
.endf

.func rt$setfield(ref tab, ref name, i64, f64, ref)
    call rt$rawset (R0, 0, 0.0, R1, I0, F0, R2)
    ret
.endf

.func rt$init_done
    mov R0, @rt$G
    call rt$setfield (R0, "_G", 0, 0.0, R0)
    call rt$setfield (R0, "_VERSION", 0, 0.0, "Lua 5.5")
    call rt$getfield (R0, "string") -> (I0, F0, R1)
    mov R2, @rt$strmeta
    call rt$rawset (R2, 0, 0.0, "__index", 0, 0.0, R1)
    call rt$getfield (R0, "math") -> (I0, F0, R1)
    call rt$setfield (R1, "pi", 0, 3.141592653589793, 4n)
    call rt$setfield (R1, "huge", 0, inf, 4n)
    call rt$setfield (R1, "maxinteger", 9223372036854775807, 0.0, null)
    mov I1, -9223372036854775807
    dec I1
    call rt$setfield (R1, "mininteger", I1, 0.0, null)
    call rt$getfield (R1, "sqrt") -> (I0, F0, R2)
    mov @rt$sqrt_fn, R2
    call rt$getfield (R0, "next") -> (I0, F0, R1)
    mov @rt$next_fn, R1
    call rt$getfield (R0, "setmetatable") -> (I0, F0, R1)
    mov @rt$setmt, R1
    mov R1, @rt$P
    call rt$getfield (R1, "ipairs_aux") -> (I0, F0, R2)
    mov @rt$ipairs_aux, R2
    ret
.endf

; The script's arguments: the arg table, and the main chunk's ... list.
.func rt$script_args -> ref
    ncall "os.args" -> (R0)
    new R1, Tab
    call rt$rawset (R1, 0, 0.0, null, 0, 0.0, @rt$chunk)
    lnew R2
    len I0, R0
    mov I1, 0
1:  bge I1, I0, 2f
    mov R3, R0[I1]
    lpush R2, R3, 0.0
    inc I1
    jmp 1b
2:  call rt$copylist (R2) -> (R4)
    call rt$setarr (R1, R4)
    mov R5, @rt$G
    call rt$setfield (R5, "arg", 0, 0.0, R1)
    ret R2
.endf

.func rt$exit(i64 code)
    call rt$closefin
    ncall "os.exit" (I0)
    ret
.endf

; An error nobody caught: report it as lua.c does, and exit with status 1.
.func rt$uncaught(ref exc)
    call rt$errvalue (R0) -> (I0, F0, R1)
    typeof I1, R1
    beq I1, 1, 2f
    bz R1, 1f
    beq.r R1, 4n, 1f
    call rt$getmm (I0, F0, R1, "__tostring") -> (I2, F2, R2)
    bne.r R2, 1n, 1f
    call rt$typename (I0, F0, R1) -> (R3)
    strcat R1, "(error object is a ", R3, " value)"
    jmp 2f
1:  call rt$tostring (I0, F0, R1) -> (R1)
2:  ncall "fs.stderr" -> (R4)    ; (writing to it flushes standard output first)
    strcat R5, "mlws-vm-lua: ", R1, "\n"
    ncall "fs.write" (R4, R5)
    bnisa R0, Error, 3f
    strcmp I3, R0->Error.code, "E_CALL_DEPTH"
    bz I3, 3f
    mov R6, R0->Error.trace     ; a fault in the runtime: where it happened
    ncall "fs.write" (R4, R6)
3:  call rt$closefin
    ncall "os.exit" (1)
    ret
.endf

; ------------------------------------------------------------------- errors

; The value of a caught exception: a Lua error's value, or a message for a
; fault the VM raised.
.func rt$errvalue(ref exc) -> (i64, f64, ref)
    bnisa R0, LuaErr, 1f
    mov I1, R0->LuaErr.i
    mov F1, R0->LuaErr.f
    mov R1, R0->LuaErr.r
    ret I1, F1, R1
1:  bnisa R0, Error, 9f
    mov R1, R0->Error.code
    mov R2, R0->Error.trace
    strcmp I0, R1, "E_CALL_DEPTH"
    bnz I0, 2f
    mov R3, "stack overflow"
    jmp 5f
2:  strcmp I0, R1, "E_QUOTA"
    bnz I0, 3f
    mov R3, "not enough memory"
    jmp 5f
3:  strcmp I0, R1, "E_CALLBACK"
    bnz I0, 4f
    mov R3, "attempt to yield across a C-call boundary"
    jmp 5f
4:  mov R4, R0->Error.message
    strcat R3, "internal error ", R1, ": ", R4
5:  call rt$trace_line (R2, -1) -> (I1)
    bz I1, 6f
    tostr R5, I1
    strcat R3, @rt$chunk, ":", R5, ": ", R3
6:  ret 0, 0.0, R3
9:  ret 0, 0.0, R0
.endf

; The line of frame `level` of a backtrace (innermost is 0), counting
; functions as Lua does: compiled Lua functions and the library's
; functions count; the runtime's helpers and the prelude (the library
; written in Lua) are skipped. Returns the Lua line, -1 if that frame is a
; library function (which has no position), or 0 if there is none. Each
; frame is a line "  at module.function (position)": a compiled Lua
; function's code has .loc positions, so its position is
; "chunk:LINE; file.masm:N"; the library's functions are B$... and P$....
.func rt$trace_frame(ref trace, i64 level) -> i64
    mov I1, 0               ; start of the next line
    mov I8, 0               ; frames counted
    len I9, R0
.try 9f
1:  bge I1, I9, 8f
    strfind I2, R0, "\n", I1
    bge I2, 0, 2f
    mov I2, I9
2:  sub I3, I2, I1
    substr R1, R0, I1, I3   ; the line
    add I1, I2, 1
    strfind I4, R1, " (", 0
    blt I4, 0, 1b
    add I5, I4, 2
    strfind I6, R1, ";", I5
    blt I6, 0, 5f
    mov I7, I5              ; the Lua line: after the last ':' before ';'
3:  strfind I10, R1, ":", I7
    blt I10, 0, 4f
    bge I10, I6, 4f
    add I7, I10, 1
    jmp 3b
4:  sub I10, I6, I7
    substr R3, R1, I7, I10
    parse.i64 I11, R3
    jmp 6f
5:  substr R2, R1, 0, I4    ; "  at module.function"
    strfind I10, R2, ".B$", 0
    bge I10, 0, 51f
    strfind I10, R2, ".P$", 0
    blt I10, 0, 1b
51: mov I11, -1
6:  beq I8, I0, 7f
    inc I8
    jmp 1b
7:  ret I11
.endtry
8:  ret 0
9:  catch R2
    ret 0
.endf

; The line for an error raised at `level`, or 0. Level -1 is an error the
; runtime raises: in the running Lua function, or for a library function
; (whose arguments were wrong, say) in the function that called it.
.func rt$trace_line(ref trace, i64 level) -> i64
    bge I0, 0, 2f
    call rt$trace_frame (R0, 0) -> (I1)
    bne I1, -1, 3f
    call rt$trace_frame (R0, 1) -> (I1)
    jmp 3f
2:  call rt$trace_frame (R0, I0) -> (I1)
3:  bge I1, 0, 4f
    mov I1, 0
4:  ret I1
.endf

; The position "chunk:line: " for an error at `level` (see rt$trace_line).
.func rt$where(i64 level) -> ref
    mov I1, 0
.try 1f
    div I2, 1, I1           ; a fault, for its backtrace
.endtry
    ret ""
1:  catch R0
    mov R1, R0->Error.trace
    call rt$trace_line (R1, I0) -> (I3)
    bz I3, 2f
    tostr R2, I3
    strcat R3, @rt$chunk, ":", R2, ": "
    ret R3
2:  ret ""
.endf

.func rt$throw(i64, f64, ref)
    new R1, LuaErr
    mov R1->LuaErr.i, I0
    mov R1->LuaErr.f, F0
    mov R1->LuaErr.r, R0
    throw R1
.endf

; A runtime error with the position of the running Lua function.
.func rt$rterror(ref msg)
    call rt$where (-1) -> (R1)
    strcat R2, R1, R0
    call rt$throw (0, 0.0, R2)
    ret
.endf

; " (local 'x')" for a description, or "".
.func rt$varinfo(ref desc) -> ref
    bz R0, 1f
    strcat R1, " (", R0, ")"
    ret R1
1:  ret ""
.endf

.func rt$typeerror(ref what, i64, f64, ref, ref desc)
    call rt$typename (I0, F0, R1) -> (R3)
    call rt$varinfo (R2) -> (R4)
    strcat R5, "attempt to ", R0, " a ", R3, " value", R4
    call rt$rterror (R5)
    ret
.endf

.func rt$err_call(i64, f64, ref, ref desc)
    call rt$typeerror ("call", I0, F0, R0, R1)
    ret
.endf

.func rt$err_index(i64, f64, ref, ref desc)
    call rt$typeerror ("index", I0, F0, R0, R1)
    ret
.endf

; "bad argument #n to 'fname' (msg)", with the function named as Lua names
; it (see rt$argwho)
.func rt$argerror(i64 n, ref fname, ref msg)
    call rt$argwho (I0, R0) -> (I1, R2, I2)
    call rt$argmsg (I1, R2, R1)
    ret
.endf

; "bad argument #n to 'fname' (T expected, got U)": U is "no value" for an
; argument the call did not pass
.func rt$argtype(i64 n, ref fname, ref expected, i64, f64, ref)
    call rt$argwho (I0, R0) -> (I3, R4, I4)
    beq.r R2, 1n, 1f
2:  call rt$typename (I1, F0, R2) -> (R3)
    jmp 3f
1:  blt I4, 0, 2b
    ble I0, I4, 2b
    mov R3, "no value"
3:  strcat R5, R1, " expected, got ", R3
    call rt$argmsg (I3, R4, R5)
    ret
.endf

.func rt$argmsg(i64 n, ref name, ref msg)
    bz I0, 1f
    tostr R2, I0
    strcat R3, "bad argument #", R2, " to '", R0, "' (", R1, ")"
    call rt$rterror (R3)
    ret
1:  strcat R3, "calling '", R0, "' on bad self (", R1, ")"
    call rt$rterror (R3)
    ret
.endf

; Who a library function's argument error names, as Lua does. Called from
; a call site in the program, the name there (with n one less for a method
; call: 0 is self); else the function's name in the library (fname if it
; has none). Also the number of arguments the call passed, or -1 if that is
; not known. The backtrace says which: under the runtime's helpers is the
; function that failed (a B$ function, or P$argerror for the prelude, the
; library written in Lua, whose frames follow it), and under that, its
; caller: compiled Lua code ("chunk:LINE; file.masm:N"), whose call
; instruction at line N the program's call sites name, or another library
; function (pcall, which called it through rt$apply).
.func rt$argwho(i64 n, ref fname) -> (i64, ref, i64)
    mov I1, 0
.try 1f
    div I2, 1, I1
.endtry
    ret I0, R0, -1
1:  catch R2
    mov R2, R2->Error.trace
    mov R5, R0              ; the library's name for it
    mov I12, -1             ; the failed function: -1 not yet seen, 0 prelude, 1 B$
    len I9, R2
    mov I1, 0               ; start of the next line
2:  bge I1, I9, 90f
    strfind I4, R2, "\n", I1
    bge I4, 0, 3f
    mov I4, I9
3:  sub I5, I4, I1
    substr R3, R2, I1, I5   ; "  at module.function (position)"
    add I1, I4, 1
    strfind I6, R3, " (", 0
    blt I6, 0, 2b
    mov I7, 0               ; the function: after the last '.' before " ("
4:  strfind I8, R3, ".", I7
    blt I8, 0, 5f
    bge I8, I6, 5f
    add I7, I8, 1
    jmp 4b
5:  sub I8, I6, I7
    substr R4, R3, I7, I8
    strfind I10, R3, ";", I6
    bge I10, 0, 30f         ; compiled Lua code: the caller
    strfind I10, R4, "rt$", 0
    beq I10, 0, 2b          ; a runtime helper
    strfind I10, R4, "B$", 0
    beq I10, 0, 10f
    strfind I10, R4, "P$", 0
    beq I10, 0, 10f
    ; the prelude's code: part of the failed function, if that is the prelude's
    beq I12, 0, 2b
    bge I12, 1, 80f
    jmp 2b
10: blt I12, 0, 13f
    ; a library function under the failed one: its caller, unless the failed
    ; one is the prelude's code for it (string.format's, say)
    bnz I12, 80f
    strfind I10, R4, "B$", 0
