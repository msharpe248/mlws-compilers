    call rt$apply (0, 0.0, R1, R0, null) -> (I0, I1, F1, R2)
    call rt$collect (I0, I1, F1, R2) -> (R3)
    ret R3
.endf

.func rt$newthread(i64, f64, ref) -> ref
    isa I1, R0, Fn
    bnz I1, 1f
    call rt$argtype (1, "create", "function", I0, F0, R0)
1:  closure rt$co_body (R0) -> (R1)
    conew R2, R1, 4096
    new R3, Thread
    mov R3->Thread.co, R2
    mov R3->Thread.fn, R0
    ret R3
.endf

.func B$co_create(i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$newthread (I0, F0, R0) -> (R1)
    ret 1, 0, 0.0, R1
.endf

; Resume a Thread with a list of values: (ok, results list or error value).
.func rt$resume(ref thread, ref args) -> (i64, i64, f64, ref)
    mov R2, R0->Thread.co
    bz R2, 7f
    costatus I0, R2
    beq I0, 3, 6f
    bnz I0, 7f
    mov R3, @rt$cur
    mov @rt$cur, R0
.try 8f
    coresume R2 (R1) -> (R4)
.endtry
    mov @rt$cur, R3
    ret 1, 0, 0.0, R4
6:  ret 0, 0, 0.0, "cannot resume dead coroutine"
7:  ret 0, 0, 0.0, "cannot resume non-suspended coroutine"
8:  catch R5
    mov @rt$cur, R3
    call rt$errvalue (R5) -> (I1, F1, R6)
    mov R0->Thread.ei, I1
    mov R0->Thread.ef, F1
    mov R0->Thread.er, R6
    mov R0->Thread.failed, 1
    ret 0, I1, F1, R6
.endf

.func B$co_resume(i64, f64, ref, ref) -> (i64, i64, f64, ref)
    isa I1, R0, Thread
    bnz I1, 1f
    call rt$argtype (1, "resume", "coroutine", I0, F0, R0)
1:  call rt$resume (R0, R1) -> (I2, I3, F3, R3)
    bz I2, 5f
    lnew R4
    lpush.r R4, 3n
    lpush R4, 0.0
    call rt$appendlist (R4, R3)
    tcall rt$retlist (R4)
5:  mov R5, @rt$mv
    STOREV R5, 0, I4, I3, F3, R3
    ret 2, 0, 0.0, 2n
.endf

.func B$co_yield(ref) -> (i64, i64, f64, ref)
    cocur R1
    bnz R1, 1f
    call rt$rterror ("attempt to yield from outside a coroutine")
1:  coyield (R0) -> (R2)
    tcall rt$retlist (R2)
.endf

.func rt$costatus(ref) -> ref
    mov R1, @rt$cur
    beq.r R0, R1, 1f
    mov R2, R0->Thread.co
    bz R2, 2f
    costatus I0, R2
    beq I0, 0, 3f
    beq I0, 1, 1f
    beq I0, 2, 2f
    ret "dead"
1:  ret "running"
2:  ret "normal"
3:  ret "suspended"
.endf

.func B$co_status(i64, f64, ref) -> (i64, i64, f64, ref)
    isa I1, R0, Thread
    bnz I1, 1f
    call rt$argtype (1, "status", "coroutine", I0, F0, R0)
1:  call rt$costatus (R0) -> (R1)
    ret 1, 0, 0.0, R1
.endf

.func B$co_running -> (i64, i64, f64, ref)
    mov R0, @rt$cur
    mov R1, @rt$mv
    mov.r R1[0], 2n
    mov R2, R0->Thread.co
    bnz R2, 1f
    mov.r R1[0], 3n
1:  mov.f64 R1[1], 0.0
    ret 2, 0, 0.0, R0
.endf

.func B$co_isyieldable -> (i64, i64, f64, ref)
    cocur R0
    bz R0, 1f
    ret 1, 0, 0.0, 3n
1:  ret 1, 0, 0.0, 2n
.endf

; The function coroutine.wrap returns (UP[0] is the Thread).
.func B$wrap_call(ref args) -> (i64, i64, f64, ref)
    mov R1, UP[0]
    call rt$resume (R1, R0) -> (I0, I1, F1, R2)
    bz I0, 5f
    tcall rt$retlist (R2)
5:  typeof I2, R2
    bne I2, 1, 6f
    call rt$where (1) -> (R3)
    strcat R2, R3, R2
6:  call rt$throw (I1, F1, R2)
    ret 0, 0, 0.0, 1n
.endf

.func B$co_wrap(i64, f64, ref) -> (i64, i64, f64, ref)
    isa I1, R0, Fn
    bnz I1, 1f
    call rt$argtype (1, "wrap", "function", I0, F0, R0)
1:  call rt$newthread (I0, F0, R0) -> (R1)
    closure B$wrap_call (R1) -> (R2)
