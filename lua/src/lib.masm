; ---------------------------------------------------------------------------
; The built-in library (lua/src/lib.masm): the functions written in
; assembly (Lua patterns are in src/match.masm). The rest (string.format's
; less common conversions, gsub, table.sort, io, os.date, utf8) is Lua, in
; src/prelude.lua. Each function follows the Lua calling
; convention; gen.c's table (src/builtins.h) gives their names and Fn.sig.
; ---------------------------------------------------------------------------

; ------------------------------------------------------------ argument checks

.func rt$checkint(i64 argn, ref fname, i64, f64, ref) -> i64
    bz R1, 1f
    beq.r R1, 4n, 2f
    typeof I2, R1
    bne I2, 1, 9f
    call rt$str2num (R1) -> (I2, I3, F1, R2)
    bz I2, 9f
    mov I1, I3
    mov F0, F1
    bz R2, 1f
2:  call rt$flt2int (F0) -> (I2, I1)
    bnz I2, 1f
    call rt$argerror (I0, R0, "number has no integer representation")
1:  ret I1
9:  call rt$argtype (I0, R0, "number", I1, F0, R1)
    ret 0
.endf

.func rt$optint(i64 argn, ref fname, i64, f64, ref, i64 def) -> i64
    beq.r R1, 1n, 1f
    call rt$checkint (I0, R0, I1, F0, R1) -> (I3)
    ret I3
1:  ret I2
.endf

; A number argument (strings convert): the number as a triple.
.func rt$checknum(i64 argn, ref fname, i64, f64, ref) -> (i64, f64, ref)
    bz R1, 1f
    beq.r R1, 4n, 1f
    typeof I2, R1
    bne I2, 1, 9f
    call rt$str2num (R1) -> (I2, I3, F1, R2)
    bz I2, 9f
    ret I3, F1, R2
1:  ret I1, F0, R1
9:  call rt$argtype (I0, R0, "number", I1, F0, R1)
    ret 0, 0.0, null
.endf

; A number argument as a float.
.func rt$checkflt(i64 argn, ref fname, i64, f64, ref) -> f64
    call rt$checknum (I0, R0, I1, F0, R1) -> (I1, F0, R1)
    bnz R1, 1f
    cvt.f64.i64 F0, I1
1:  ret F0
.endf

; A string argument (numbers convert).
.func rt$checkstr(i64 argn, ref fname, i64, f64, ref) -> ref
    typeof I2, R1
    bne I2, 1, 1f
    ret R1
1:  bz R1, 2f
    beq.r R1, 4n, 2f
    call rt$argtype (I0, R0, "string", I1, F0, R1)
2:  call rt$tostr_num (I1, F0, R1) -> (R2)
    ret R2
.endf

.func rt$checktab(i64 argn, ref fname, i64, f64, ref)
    isa I2, R1, Tab
    bnz I2, 1f
    call rt$argtype (I0, R0, "table", I1, F0, R1)
1:  ret
.endf

; Results: one value, or none.
.macro RET1 i, f, r
    ret 1, \i, \f, \r
.endm

; ------------------------------------------------------------------- base

.func B$print(ref) -> (i64, i64, f64, ref)
    len I0, R0
    mov I1, 0
    bufnew R1, 0
1:  bge I1, I0, 9f
    bz I1, 2f
    bufpush R1, 9
2:  LOADV R0, I1, I2, I3, F3, R3
    typeof I4, R3
    bne I4, 1, 3f
    bufcat R1, R3
    jmp 4f
3:  call rt$tostring (I3, F3, R3) -> (R4)
    bufcat R1, R4
4:  add I1, 2
    jmp 1b
9:  bufpush R1, 10
    ncall "io.print_s" (R1)
    ret 0, 0, 0.0, 1n
.endf

.func B$type(i64 nargs, i64, f64, ref) -> (i64, i64, f64, ref)
    bz I0, 9f
    call rt$typename (I1, F0, R0) -> (R1)
    ret 1, 0, 0.0, R1
9:  call rt$argerror (1, "type", "value expected")
    ret 0, 0, 0.0, 1n
.endf

.func B$tostring(i64 nargs, i64, f64, ref) -> (i64, i64, f64, ref)
    bz I0, 9f
    call rt$tostring (I1, F0, R0) -> (R1)
    ret 1, 0, 0.0, R1
9:  call rt$argerror (1, "tostring", "value expected")
    ret 0, 0, 0.0, 1n
.endf

.func B$tonumber(i64 nargs, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    blt I0, 2, 1f
    beq.r R1, 1n, 1f
    tcall rt$tonumber_base (I1, F0, R0, I2, F1, R1)
1:  bz R0, 8f
    beq.r R0, 4n, 8f
    typeof I3, R0
    bne I3, 1, 2f
    call rt$str2num (R0) -> (I4, I1, F0, R0)
    bz I4, 7f
8:  ret 1, I1, F0, R0
2:  bnz I0, 7f
    call rt$argerror (1, "tonumber", "value expected")
7:  ret 1, 0, 0.0, 1n
.endf

.func rt$tonumber_base(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkint (2, "tonumber", I1, F1, R1) -> (I2)
    typeof I3, R0
    beq I3, 1, 1f
    call rt$argtype (1, "tonumber", "string", I0, F0, R0)
1:  blt I2, 2, 2f
    ble I2, 36, 3f
2:  call rt$argerror (2, "tonumber", "base out of range")
3:  len I4, R0
    mov I5, 0
    ; spaces
4:  bge I5, I4, 90f
    mov I6, R0[I5]
    call rt$isspace (I6) -> (I7)
    bz I7, 5f
    inc I5
    jmp 4b
5:  mov I8, 0           ; negative
    bne I6, '-', 6f
    mov I8, 1
    inc I5
6:  mov I9, 0           ; value
    mov I10, 0          ; digits
7:  bge I5, I4, 20f
    mov I6, R0[I5]
    call rt$isspace (I6) -> (I7)
    bnz I7, 10f
    blt I6, '0', 90f
    ble I6, '9', 8f
    or I6, 32
    blt I6, 'a', 90f
    bgt I6, 'z', 90f
    sub I6, 'a' - 10
    jmp 9f
8:  sub I6, '0'
9:  bge I6, I2, 90f
    mul I9, I2
    add I9, I6
    inc I10
    inc I5
    jmp 7b
10: inc I5              ; trailing spaces
    bge I5, I4, 20f
    mov I6, R0[I5]
    call rt$isspace (I6) -> (I7)
    bz I7, 90f
    jmp 10b
20: bz I10, 90f
    bz I8, 21f
    neg I9
21: ret 1, I9, 0.0, null
90: ret 1, 0, 0.0, 1n
.endf

; ipairs(t): the iterator, t, 0
.func B$ipairs(i64 nargs, i64, f64, ref) -> (i64, i64, f64, ref)
    bnz I0, 1f
    call rt$argtype (1, "ipairs", "table", I1, F0, R0)
1:  mov R1, @rt$mv
    STOREV R1, 0, I2, I1, F0, R0
    mov.r R1[2], null
    mov.i64 R1[3], 0
    mov R2, @rt$ipairs_aux
    ret 3, 0, 0.0, R2
.endf

.func P$ipairs_aux(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    add I1, 1
    isa I2, R0, Tab
    bz I2, 5f
    mov R2, R0->Tab.meta
    bnz R2, 5f
    sub I3, I1, 1
    mov I4, R0->Tab.n
    bge I3, I4, 5f
    mov R3, R0->Tab.arr
    add I3, I3
    LOADV R3, I3, I5, I6, F6, R6
    jmp 6f
5:  call rt$index (I0, F0, R0, I1, 0.0, null, null) -> (I6, F6, R6)
6:  beq.r R6, 1n, 9f
    mov R7, @rt$mv
    STOREV R7, 0, I5, I6, F6, R6
    ret 2, I1, 0.0, null
9:  ret 1, 0, 0.0, 1n
.endf

; pairs(t): __pairs, or next, t, nil
.func B$pairs(i64 nargs, i64, f64, ref) -> (i64, i64, f64, ref)
    bnz I0, 1f
    call rt$argtype (1, "pairs", "table", I1, F0, R0)
1:  call rt$getmm (I1, F0, R0, "__pairs") -> (I2, F2, R2)
    beq.r R2, 1n, 2f
    call rt$call1 (null, I2, F2, R2, I1, F0, R0) -> (I3, I4, F4, R4)
    call rt$mvget (I3, 2) -> (I5, F5, R5)
    call rt$mvget (I3, 3) -> (I6, F6, R6)
    mov R7, @rt$mv
    STOREV R7, 0, I8, I5, F5, R5
    STOREV R7, 2, I8, I6, F6, R6
    ret 3, I4, F4, R4
2:  mov R7, @rt$mv
    STOREV R7, 0, I8, I1, F0, R0
    mov.r R7[2], 1n
    mov.f64 R7[3], 0.0
    mov R3, @rt$next_fn
    ret 3, 0, 0.0, R3
.endf

.func B$next(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    isa I2, R0, Tab
    bnz I2, 1f
    call rt$argtype (1, "next", "table", I0, F0, R0)
1:  call rt$next (R0, I1, F1, R1) -> (I3, F3, R3, I4, F4, R4)
    beq.r R3, 1n, 9f
    mov R5, @rt$mv
    STOREV R5, 0, I5, I4, F4, R4
    ret 2, I3, F3, R3
9:  ret 1, 0, 0.0, 1n
.endf

.func B$select(i64, f64, ref, ref) -> (i64, i64, f64, ref)
    len I1, R1
    div I1, 2
    typeof I2, R0
    bne I2, 1, 1f
    mov I3, R0[0]
    bne I3, '#', 1f
    ret 1, I1, 0.0, null
1:  call rt$checkint (1, "select", I0, F0, R0) -> (I4)
    bge I4, 0, 2f
    add I4, I1
    blt I4, 0, 8f
    jmp 3f
2:  bz I4, 8f
    dec I4
3:  call rt$sublist (R1, I4) -> (R2)
    tcall rt$retlist (R2)
8:  call rt$argerror (1, "select", "index out of range")
    ret 0, 0, 0.0, 1n
.endf

.func B$rawget(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checktab (1, "rawget", I0, F0, R0)
    call rt$rawget (R0, I1, F1, R1) -> (I2, F2, R2)
    ret 1, I2, F2, R2
.endf

.func B$rawset(i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checktab (1, "rawset", I0, F0, R0)
    call rt$rawset (R0, I1, F1, R1, I2, F2, R2)
    ret 1, 0, 0.0, R0
.endf

.func rt$rawequal(i64, f64, ref, i64, f64, ref) -> i64
    beq.r R0, R1, 1f
    bz R0, 2f
    bz R1, 2f
    beq.r R0, 4n, 2f
    beq.r R1, 4n, 2f
    typeof I2, R0
    bne I2, 1, 8f
    typeof I2, R1
    bne I2, 1, 8f
    strcmp I3, R0, R1
    bz I3, 9f
8:  ret 0
2:  call rt$eq (I0, F0, R0, I1, F1, R1) -> (I3)
    ret I3
1:  bnz R0, 3f
    seq I3, I0, I1
    ret I3
3:  bne.r R0, 4n, 9f
    seq.f64 I3, F0, F1
    ret I3
9:  ret 1
.endf

.func B$rawequal(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$rawequal (I0, F0, R0, I1, F1, R1) -> (I2)
    mov.r R2, 2n
    bz I2, 1f
    mov.r R2, 3n
1:  ret 1, 0, 0.0, R2
.endf

.func B$rawlen(i64, f64, ref) -> (i64, i64, f64, ref)
    isa I1, R0, Tab
    bz I1, 1f
    mov I2, R0->Tab.n
    ret 1, I2, 0.0, null
1:  typeof I1, R0
    bne I1, 1, 2f
    len I2, R0
    ret 1, I2, 0.0, null
2:  call rt$argerror (1, "rawlen", "table or string expected")
    ret 0, 0, 0.0, 1n
.endf

.func B$setmetatable(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checktab (1, "setmetatable", I0, F0, R0)
    beq.r R1, 1n, 1f
    isa I2, R1, Tab
    bnz I2, 1f
    call rt$argtype (2, "setmetatable", "nil or table", I1, F1, R1)
1:  mov R2, R0->Tab.meta
    bz R2, 2f
    mov I3, R2->Tab.prot
    bz I3, 2f
    call rt$rterror ("cannot change a protected metatable")
2:  bne.r R1, 1n, 3f
    mov.r R1, null
3:  mov R0->Tab.meta, R1
    ret 1, 0, 0.0, R0
.endf

.func B$getmetatable(i64, f64, ref) -> (i64, i64, f64, ref)
    isa I1, R0, Tab
    bz I1, 1f
    mov R1, R0->Tab.meta
    bz R1, 9f
    jmp 2f
1:  typeof I1, R0
    bne I1, 1, 9f
    mov R1, @rt$strmeta
2:  mov I4, R1->Tab.prot
    bz I4, 3f
    call rt$rawget (R1, 0, 0.0, "__metatable") -> (I3, F3, R3)
    beq.r R3, 1n, 3f
    ret 1, I3, F3, R3
3:  ret 1, 0, 0.0, R1
9:  ret 1, 0, 0.0, 1n
.endf

.func B$assert(ref) -> (i64, i64, f64, ref)
    len I0, R0
    bnz I0, 1f
    call rt$argerror (1, "assert", "value expected")
1:  mov R1, R0[0]
    call rt$truthy (R1) -> (I1)
    bz I1, 2f
    tcall rt$retlist (R0)
2:  blt I0, 4, 3f
    call rt$listget (R0, 1) -> (I2, F2, R2)
    typeof I3, R2
    bne I3, 1, 21f
    call rt$where (1) -> (R3)
    strcat R2, R3, R2
21: call rt$throw (I2, F2, R2)
3:  call rt$rterror ("assertion failed!")
    ret 0, 0, 0.0, 1n
.endf

.func B$error(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    beq.r R0, 1n, 5f
    typeof I2, R0
    bne I2, 1, 9f
    call rt$optint (2, "error", I1, F1, R1, 1) -> (I3)
    ble I3, 0, 9f
    call rt$where (I3) -> (R2)
    strcat R0, R2, R0
    jmp 9f
5:  mov R0, "<no error object>"
9:  call rt$throw (I0, F0, R0)
    ret 0, 0, 0.0, 1n
.endf

; Put first in front of the results in @rt$mv (n of them).
.func rt$shiftmv(i64 n, i64, f64, ref)
    blt I0, 1, 9f
    add I2, I0, I0
    call rt$mvreserve (I2) -> (R1)
    sub I3, I2, 3           ; last word to move
1:  blt I3, 0, 2f
    add I4, I3, 2
    mov R1[I4], R1[I3]
    dec I3
    jmp 1b
2:  STOREV R1, 0, I5, I1, F0, R0
9:  ret
.endf

.func B$pcall(i64, f64, ref, ref) -> (i64, i64, f64, ref)
.try 8f
    call rt$apply (I0, F0, R0, R1, null) -> (I1, I2, F2, R2)
.endtry
    call rt$shiftmv (I1, I2, F2, R2)
    add I1, 1
    ret I1, 0, 0.0, 3n
8:  catch R3
    call rt$errvalue (R3) -> (I4, F4, R4)
    mov R5, @rt$mv
    STOREV R5, 0, I5, I4, F4, R4
    ret 2, 0, 0.0, 2n
.endf

.func B$xpcall(i64, f64, ref, i64, f64, ref, ref) -> (i64, i64, f64, ref)
.try 8f
    call rt$apply (I0, F0, R0, R2, null) -> (I2, I3, F3, R3)
.endtry
    call rt$shiftmv (I2, I3, F3, R3)
    add I2, 1
    ret I2, 0, 0.0, 3n
8:  catch R4
    call rt$errvalue (R4) -> (I4, F4, R4)
    call rt$call1 (null, I1, F1, R1, I4, F4, R4) -> (I5, I6, F6, R6)
    mov R5, @rt$mv
    STOREV R5, 0, I7, I6, F6, R6
    ret 2, 0, 0.0, 2n
.endf

.func B$collectgarbage(i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    beq.r R0, 1n, 1f
    typeof I2, R0
    bne I2, 1, 1f
    strcmp I2, R0, "count"
    bz I2, 2f
    strcmp I2, R0, "collect"
    bz I2, 1f
    strcmp I2, R0, "step"
    bz I2, 3f
    strcmp I2, R0, "isrunning"
    bz I2, 3f
    strcmp I2, R0, "incremental"
    bz I2, 4f
    strcmp I2, R0, "generational"
    bz I2, 4f
    ret 1, 0, 0.0, null
1:  ncall "gc.collect"
    ret 1, 0, 0.0, null
2:  ncall "gc.heap_bytes" -> (I3)
    cvt.f64.i64 F3, I3
    div F3, 1024.0
    ret 1, 0, F3, 4n
3:  ret 1, 0, 0.0, 3n
4:  ret 1, 0, 0.0, "incremental"
.endf

.func B$load(ref) -> (i64, i64, f64, ref)
    mov R1, @rt$mv
    mov.r R1[0], "load is not supported by mlws-vm-lua (programs are compiled ahead of time)"
    mov.f64 R1[1], 0.0
    ret 2, 0, 0.0, 1n
.endf

.func B$dofile(ref) -> (i64, i64, f64, ref)
    call rt$rterror ("dofile is not supported by mlws-vm-lua (programs are compiled ahead of time)")
    ret 0, 0, 0.0, 1n
.endf

; ----------------------------------------------------------------- string

.func B$str_len(i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkstr (1, "len", I0, F0, R0) -> (R1)
    len I1, R1
    ret 1, I1, 0.0, null
.endf

; The start position of a range (posrelatI) and its end (getendpos).
.func rt$posstart(i64 pos, i64 len) -> i64
    bgt I0, 0, 9f
    bz I0, 1f
    neg I2, I1
    blt I0, I2, 1f
    add I0, I1
    inc I0
9:  ret I0
1:  ret 1
.endf

.func rt$posend(i64 pos, i64 len) -> i64
    bgt I0, I1, 1f
    bge I0, 0, 9f
    neg I2, I1
    blt I0, I2, 2f
    add I0, I1
    inc I0
9:  ret I0
1:  ret I1
2:  ret 0
.endf

.func B$str_sub(i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    typeof I3, R0
    bne I3, 1, 1f
    bnz R1, 1f
    mov R3, R0
    len I3, R3
    mov I4, I1
    mov I5, -1
    beq.r R2, 1n, 2f
    bnz R2, 1f
    mov I5, I2
    jmp 2f
1:  call rt$checkstr (1, "sub", I0, F0, R0) -> (R3)
    len I3, R3
    call rt$optint (2, "sub", I1, F1, R1, 1) -> (I4)
    call rt$optint (3, "sub", I2, F2, R2, -1) -> (I5)
2:  call rt$posstart (I4, I3) -> (I4)
    call rt$posend (I5, I3) -> (I5)
    bgt I4, I5, 9f
    sub I6, I5, I4
    inc I6
    dec I4
    substr R4, R3, I4, I6
    ret 1, 0, 0.0, R4
9:  ret 1, 0, 0.0, ""
.endf

.func B$str_upper(i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkstr (1, "upper", I0, F0, R0) -> (R1)
    ncall "text.ascii_upper" (R1) -> (R2)
