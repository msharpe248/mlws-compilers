; P.time(year, month, day, hour, min, sec): seconds, in local time.
.func P$time(i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
