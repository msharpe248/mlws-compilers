    mov I3, R0->Thread.failed
    bnz I3, 4f
    ret 1, 0, 0.0, 3n
4:  mov I4, R0->Thread.ei
    mov F4, R0->Thread.ef
    mov R4, R0->Thread.er
    mov R5, @rt$mv
    STOREV R5, 0, I5, I4, F4, R4
    mov R0->Thread.failed, 0
    ret 2, 0, 0.0, 2n
.endf

