.endf

.func B$str_lower(i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkstr (1, "lower", I0, F0, R0) -> (R1)
    ncall "text.ascii_lower" (R1) -> (R2)
    ret 1, 0, 0.0, R2
.endf

.func B$str_rep(i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkstr (1, "rep", I0, F0, R0) -> (R3)
    call rt$checkint (2, "rep", I1, F1, R1) -> (I3)
    ble I3, 0, 8f
    beq.r R2, 1n, 5f
    call rt$checkstr (3, "rep", I2, F2, R2) -> (R4)
    len I4, R3
    len I5, R4
    add I6, I4, I5
    mul I6, I3
    bgt I6, 2000000000, 7f
    bufnew R5, 0
    mov I7, 0
1:  bge I7, I3, 2f
    bz I7, 11f
    bufcat R5, R4
11: bufcat R5, R3
    inc I7
    jmp 1b
2:  strcat R6, R5
    ret 1, 0, 0.0, R6
5:  len I4, R3
    mul I6, I4, I3
    bgt I6, 2000000000, 7f
    ncall "text.repeat" (R3, I3) -> (R6)
    ret 1, 0, 0.0, R6
7:  call rt$rterror ("resulting string too large")
8:  ret 1, 0, 0.0, ""
.endf

.func B$str_reverse(i64, f64, ref) -> (i64, i64, f64, ref)
    call rt$checkstr (1, "reverse", I0, F0, R0) -> (R1)
    len I1, R1
    bufnew R2, 0
1:  bz I1, 2f
