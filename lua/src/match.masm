.endf

; Match the pattern from p against the subject from s: the end, or -1.
.func pm$do(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.depth
    bnz I2, 1f
    call rt$rterror ("pattern too complex")
1:  dec I2
    mov R0->MState.depth, I2
    mov R1, R0->MState.pat
    mov I3, R0->MState.plen
10: beq I1, I3, 90f
    mov I4, R1[I1]
    bne I4, '(', 20f
    add I5, I1, 1
    bge I5, I3, 11f
    mov I6, R1[I5]
    bne I6, ')', 11f
    add I5, I1, 2
