; ---------------------------------------------------------------------------
; Lua patterns (lua/src/match.masm): the matcher of lstrlib.c, for
; string.find, match, gmatch and gsub (whose Lua halves are in the
; prelude). Positions are 0-based here; a failed match is -1.
; ---------------------------------------------------------------------------

.struct MState
    src: ref
    slen: i64
    pat: ref
    plen: i64
    level: i64
    depth: i64
    cs: ref             ; capture starts (a list of i64)
    cl: ref             ; capture lengths: -1 unfinished, -2 a position
.ends

; The end of the pattern item at p.
.func pm$class_end(ref ms, i64 p) -> i64
    mov R1, R0->MState.pat
    mov I1, R0->MState.plen
    mov I2, R1[I0]
    inc I0
    bne I2, '%', 2f
    bge I0, I1, 9f
    inc I0
    ret I0
2:  bne I2, '[', 5f
    bge I0, I1, 3f
    mov I3, R1[I0]
    bne I3, '^', 3f
    inc I0
3:  bge I0, I1, 8f
    mov I3, R1[I0]
    inc I0
    bne I3, '%', 4f
    bge I0, I1, 4f
    inc I0
4:  bge I0, I1, 3b
    mov I3, R1[I0]
    bne I3, ']', 3b
    inc I0
5:  ret I0
8:  call rt$rterror ("malformed pattern (missing ']')")
    ret 0
9:  call rt$rterror ("malformed pattern (ends with '%')")
    ret 0
.endf

        .align 8
pm$tables:  .zero 8     ; a list of 128 tables: for class letter cl, 256 flags

; The table of class %cl: a list of 256 integers, 1 for the characters in it.
.func pm$table(i64 cl) -> ref
    mov R0, @pm$tables
    bnz R0, 1f
    lnew R0, 128
    resize R0, 128
    mov @pm$tables, R0
1:  mov R1, R0[I0]
    bnz R1, 9f
    lnew R1, 256
    mov I1, 0
2:  call pm$class (I1, I0) -> (I2)
    lpush R1, I2
    inc I1
    blt I1, 256, 2b
    mov R0[I0], R1
9:  ret R1
.endf

; Does character c belong to class %cl?
.func pm$class(i64 c, i64 cl) -> i64
    or I2, I1, 32
    beq I2, 'a', 10f
    beq I2, 'c', 11f
    beq I2, 'd', 12f
    beq I2, 'g', 13f
    beq I2, 'l', 14f
    beq I2, 'p', 15f
    beq I2, 's', 16f
    beq I2, 'u', 17f
    beq I2, 'w', 18f
    beq I2, 'x', 19f
    seq I3, I0, I1
    ret I3
10: or I4, I0, 32
    mov I3, 0
    blt I4, 'a', 90f
    bgt I4, 'z', 90f
    mov I3, 1
    jmp 90f
11: mov I3, 1
    blt I0, 32, 90f
    beq I0, 127, 90f
    mov I3, 0
    jmp 90f
12: mov I3, 0
    blt I0, '0', 90f
    bgt I0, '9', 90f
    mov I3, 1
    jmp 90f
13: mov I3, 0
    blt I0, 33, 90f
    bgt I0, 126, 90f
    mov I3, 1
    jmp 90f
14: mov I3, 0
    blt I0, 'a', 90f
    bgt I0, 'z', 90f
    mov I3, 1
    jmp 90f
15: mov I3, 0
    blt I0, 33, 90f
    bgt I0, 126, 90f
    mov I3, 1
    blt I0, '0', 90f
    ble I0, '9', 151f
    blt I0, 'A', 90f
    ble I0, 'Z', 151f
    blt I0, 'a', 90f
    ble I0, 'z', 151f
    jmp 90f
151: mov I3, 0
    jmp 90f
16: mov I3, 1
    beq I0, 32, 90f
    blt I0, 9, 161f
    ble I0, 13, 90f
161: mov I3, 0
    jmp 90f
17: mov I3, 0
    blt I0, 'A', 90f
    bgt I0, 'Z', 90f
    mov I3, 1
    jmp 90f
18: mov I3, 1
    blt I0, '0', 181f
    ble I0, '9', 90f
181: or I4, I0, 32
    blt I4, 'a', 182f
    ble I4, 'z', 90f
182: mov I3, 0
    jmp 90f
19: mov I3, 1
    blt I0, '0', 191f
    ble I0, '9', 90f
191: or I4, I0, 32
    blt I4, 'a', 192f
    ble I4, 'f', 90f
192: mov I3, 0
90: blt I1, 'A', 91f
    bgt I1, 'Z', 91f
    xor I3, 1
91: ret I3
.endf

; Does c match the set [...] from p (its '[') to ec (its ']')?
.func pm$bracket(ref ms, i64 c, i64 p, i64 ec) -> i64
    mov R1, R0->MState.pat
    mov I3, 1               ; sig
    add I4, I1, 1
    mov I5, R1[I4]
    bne I5, '^', 1f
    mov I3, 0
    inc I1
1:  inc I1
    bge I1, I2, 8f
    mov I5, R1[I1]
    bne I5, '%', 2f
    inc I1
    mov I6, R1[I1]
    call pm$class (I0, I6) -> (I7)
    bnz I7, 9f
    jmp 1b
2:  add I4, I1, 1
    mov I6, R1[I4]
    bne I6, '-', 3f
    add I4, I1, 2
    bge I4, I2, 3f
    mov I6, R1[I4]
    mov I1, I4
    blt I0, I5, 1b
    bgt I0, I6, 1b
    jmp 9f
3:  beq I5, I0, 9f
    jmp 1b
8:  xor I3, 1
9:  ret I3
.endf

; Does the character at s match the single item p .. ep?
.func pm$single(ref ms, i64 s, i64 p, i64 ep) -> i64
    mov I3, R0->MState.slen
    bge I0, I3, 8f
    mov R1, R0->MState.src
    mov I4, R1[I0]
    mov R2, R0->MState.pat
    mov I5, R2[I1]
    beq I5, '.', 7f
    bne I5, '%', 2f
    add I6, I1, 1
    mov I6, R2[I6]
    bge I6, 128, 4f
    call pm$table (I6) -> (R3)
    mov I7, R3[I4]
    ret I7
4:  bne I6, I4, 8f
    ret 1
2:  bne I5, '[', 3f
    sub I6, I2, 1
    call pm$bracket (R0, I4, I1, I6) -> (I7)
    ret I7
3:  bne I5, I4, 8f
7:  ret 1
8:  ret 0
.endf

.func pm$max_expand(ref ms, i64 s, i64 p, i64 ep) -> i64
    mov I3, 0
    mov R1, R0->MState.src
    mov I7, R0->MState.slen
    mov R2, R0->MState.pat
    mov I8, R2[I1]
    ; how many characters match the item: tight loops for '.', a
    ; character and a %class
    bne I8, '.', 11f
    sub I3, I7, I0
    max I3, 0
    jmp 2f
11: beq I8, '[', 1f
    add I4, I0, I3
    bne I8, '%', 13f
    add I9, I1, 1
    mov I9, R2[I9]
    bge I9, 128, 1f
    call pm$table (I9) -> (R3)
12: bge I4, I7, 14f
    mov I5, R1[I4]
    mov I6, R3[I5]
    bz I6, 14f
    inc I4
    jmp 12b
13: bge I4, I7, 14f
    mov I5, R1[I4]
    bne I5, I8, 14f
    inc I4
    jmp 13b
14: sub I3, I4, I0
    jmp 2f
1:  add I4, I0, I3
    call pm$single (R0, I4, I1, I2) -> (I5)
    bz I5, 2f
    inc I3
    jmp 1b
2:  add I6, I2, 1
3:  blt I3, 0, 9f
    add I4, I0, I3
    call pm$do (R0, I4, I6) -> (I5)
    bge I5, 0, 8f
    dec I3
    jmp 3b
8:  ret I5
9:  ret -1
.endf

.func pm$min_expand(ref ms, i64 s, i64 p, i64 ep) -> i64
    add I6, I2, 1
1:  call pm$do (R0, I0, I6) -> (I5)
    bge I5, 0, 8f
    call pm$single (R0, I0, I1, I2) -> (I4)
    bz I4, 9f
    inc I0
    jmp 1b
8:  ret I5
9:  ret -1
.endf

.func pm$start_capture(ref ms, i64 s, i64 p, i64 what) -> i64
    mov I3, R0->MState.level
    blt I3, 32, 1f
    call rt$rterror ("too many captures")
1:  mov R1, R0->MState.cs
    mov R1[I3], I0
    mov R1, R0->MState.cl
    mov R1[I3], I2
    add I4, I3, 1
    mov R0->MState.level, I4
    call pm$do (R0, I0, I1) -> (I5)
    bge I5, 0, 2f
    mov R0->MState.level, I3
2:  ret I5
.endf

.func pm$end_capture(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.level
    mov R1, R0->MState.cl
1:  dec I2
    blt I2, 0, 8f
    mov I3, R1[I2]
    bne I3, -1, 1b
    mov R2, R0->MState.cs
    mov I4, R2[I2]
    sub I5, I0, I4
    mov R1[I2], I5
    call pm$do (R0, I0, I1) -> (I6)
    bge I6, 0, 2f
    mov R1[I2], -1
2:  ret I6
8:  call rt$rterror ("invalid pattern capture")
    ret -1
.endf

.func pm$balance(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.plen
    add I3, I1, 1
    blt I3, I2, 1f
    call rt$rterror ("malformed pattern (missing arguments to '%b')")
1:  mov I4, R0->MState.slen
    bge I0, I4, 9f
    mov R1, R0->MState.src
    mov R2, R0->MState.pat
    mov I5, R2[I1]          ; b
    mov I6, R2[I3]          ; e
    mov I7, R1[I0]
    bne I7, I5, 9f
    mov I8, 1
2:  inc I0
    bge I0, I4, 9f
    mov I7, R1[I0]
    bne I7, I6, 3f
    dec I8
    bnz I8, 2b
    inc I0
    ret I0
3:  bne I7, I5, 2b
    inc I8
    jmp 2b
9:  ret -1
.endf

.func pm$match_capture(ref ms, i64 s, i64 l) -> i64
    sub I1, '1'
    blt I1, 0, 8f
    mov I2, R0->MState.level
    bge I1, I2, 8f
    mov R1, R0->MState.cl
    mov I3, R1[I1]
    beq I3, -1, 8f
    mov R2, R0->MState.cs
    mov I4, R2[I1]
    mov I5, R0->MState.slen
    sub I6, I5, I0
    blt I6, I3, 9f
    mov R3, R0->MState.src
    mov I7, 0
1:  bge I7, I3, 2f
    add I8, I4, I7
    mov I9, R3[I8]
    add I8, I0, I7
    mov I10, R3[I8]
    bne I9, I10, 9f
    inc I7
    jmp 1b
2:  add I0, I3
    ret I0
8:  add I1, 1
    tostr R4, I1
    strcat R5, "invalid capture index %", R4
    call rt$rterror (R5)
9:  ret -1
.endf

; Match the pattern from p against the subject from s: the end, or -1.
.func pm$do(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.depth
    bnz I2, 1f
    call rt$rterror ("pattern too complex")
1:  dec I2
    mov R0->MState.depth, I2
    mov R1, R0->MState.pat
    mov I3, R0->MState.plen
10: beq I1, I3, 90f
    mov I4, R1[I1]
    bne I4, '(', 20f
    add I5, I1, 1
    bge I5, I3, 11f
    mov I6, R1[I5]
    bne I6, ')', 11f
    add I5, I1, 2
    call pm$start_capture (R0, I0, I5, -2) -> (I0)
    jmp 90f
11: call pm$start_capture (R0, I0, I5, -1) -> (I0)
    jmp 90f
20: bne I4, ')', 30f
    add I5, I1, 1
    call pm$end_capture (R0, I0, I5) -> (I0)
    jmp 90f
30: bne I4, '$', 40f
    add I5, I1, 1
    bne I5, I3, 50f
    mov I6, R0->MState.slen
    beq I0, I6, 90f
    mov I0, -1
    jmp 90f
40: bne I4, '%', 50f
    add I5, I1, 1
    bge I5, I3, 50f
    mov I6, R1[I5]
    bne I6, 'b', 41f
    add I7, I1, 2
    call pm$balance (R0, I0, I7) -> (I0)
    blt I0, 0, 90f
    add I1, 4
    jmp 10b
41: bne I6, 'f', 43f
    add I1, 2
    bge I1, I3, 42f
    mov I7, R1[I1]
    beq I7, '[', 421f
42: call rt$rterror ("missing '[' after '%f' in pattern")
421: call pm$class_end (R0, I1) -> (I8)
    mov I9, 0
    bz I0, 422f
    mov R2, R0->MState.src
    sub I10, I0, 1
    mov I9, R2[I10]
422: mov I11, 0
    mov I12, R0->MState.slen
    bge I0, I12, 423f
    mov R2, R0->MState.src
    mov I11, R2[I0]
423: sub I13, I8, 1
    call pm$bracket (R0, I9, I1, I13) -> (I14)
    bnz I14, 424f
    call pm$bracket (R0, I11, I1, I13) -> (I14)
    bz I14, 424f
    mov I1, I8
    jmp 10b
424: mov I0, -1
    jmp 90f
43: blt I6, '0', 50f
    bgt I6, '9', 50f
    call pm$match_capture (R0, I0, I6) -> (I0)
    blt I0, 0, 90f
    add I1, 2
    jmp 10b
50: ; an item with an optional suffix
    call pm$class_end (R0, I1) -> (I8)
    mov I9, 0
    bge I8, I3, 51f
    mov I9, R1[I8]
51: call pm$single (R0, I0, I1, I8) -> (I10)
    bnz I10, 60f
    beq I9, '*', 52f
    beq I9, '?', 52f
    beq I9, '-', 52f
    mov I0, -1
    jmp 90f
52: add I1, I8, 1
    jmp 10b
60: bne I9, '?', 62f
    add I11, I0, 1
    add I12, I8, 1
    call pm$do (R0, I11, I12) -> (I13)
    blt I13, 0, 61f
    mov I0, I13
    jmp 90f
61: mov I1, I12
    jmp 10b
62: bne I9, '+', 63f
    inc I0
    call pm$max_expand (R0, I0, I1, I8) -> (I0)
    jmp 90f
63: bne I9, '*', 64f
    call pm$max_expand (R0, I0, I1, I8) -> (I0)
    jmp 90f
64: bne I9, '-', 65f
    call pm$min_expand (R0, I0, I1, I8) -> (I0)
    jmp 90f
65: inc I0
    mov I1, I8
    jmp 10b
90: mov I2, R0->MState.depth
    inc I2
    mov R0->MState.depth, I2
    ret I0
.endf

; P.match(src, pat, s, p, caps, scan, last): match pat from (1-based) item
; p against src from s. With scan, try s, s + 1, ... up to the end of src,
; skipping a match that ends at last (as gmatch and gsub do after an empty
; match). Returns the end (1-based, exclusive), the number of captures and
; where the match starts, with caps[2i-1], caps[2i] the start and length of
; capture i (length -2: a position capture); or nil.
.func P$match(i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref, i64, f64, ref) -> (i64, i64, f64, ref)
    new R7, MState
    mov R7->MState.src, R0
    len I7, R0
    mov R7->MState.slen, I7
    mov R7->MState.pat, R1
    len I8, R1
    mov R7->MState.plen, I8
    lnew R8, 32
    resize R8, 32
    mov R7->MState.cs, R8
    lnew R9, 32
    resize R9, 32
    mov R7->MState.cl, R9
    sub I9, I2, 1           ; s
    sub I10, I3, 1          ; p
    sub I11, I6, 1          ; last (0-based), -2 if nil
    beq.r R6, 1n, 1f
    jmp 10f
1:  mov I11, -2
10: ; when scanning, a first item that must match once filters positions
    ; without running the whole matcher (I18: its end, or -1 for none)
    mov I18, -1
    beq.r R5, 1n, 2f
    beq.r R5, 2n, 2f
    bge I10, I8, 2f
    mov I19, R1[I10]
    beq I19, '(', 2f
    beq I19, ')', 2f
    beq I19, '^', 2f
    bne I19, '$', 11f
    add I20, I10, 1
    beq I20, I8, 2f
11: bne I19, '%', 12f
    add I20, I10, 1
    bge I20, I8, 2f
    mov I21, R1[I20]
    beq I21, 'b', 2f
    beq I21, 'f', 2f
    blt I21, '0', 12f
    ble I21, '9', 2f
12: call pm$class_end (R7, I10) -> (I20)
    bge I20, I8, 13f
    mov I21, R1[I20]
    beq I21, '*', 2f
    beq I21, '?', 2f
    beq I21, '-', 2f
13: mov I18, I20
2:  mov I22, 0
    mov R7->MState.level, I22
    mov I22, 200
    mov R7->MState.depth, I22
    blt I18, 0, 21f
    call pm$single (R7, I9, I10, I18) -> (I23)
    bz I23, 3f
21: call pm$do (R7, I9, I10) -> (I12)
    blt I12, 0, 3f
    bne I12, I11, 5f
3:  beq.r R5, 1n, 9f
    beq.r R5, 2n, 9f
    inc I9
    ble I9, I7, 2b
    jmp 9f
5:  mov I13, R7->MState.level
    mov I14, 0
6:  bge I14, I13, 7f
    mov I15, R8[I14]
    inc I15
    add I16, I14, I14
    inc I16
    call rt$rawset (R4, I16, 0.0, null, I15, 0.0, null)
    mov I15, R9[I14]
    inc I16
    call rt$rawset (R4, I16, 0.0, null, I15, 0.0, null)
    inc I14
    jmp 6b
7:  inc I12
    inc I9
    mov R10, @rt$mv
    mov I17, 0
    mov.r R10[I17], null
    inc I17
    mov R10[I17], I13
    inc I17
    mov.r R10[I17], null
    inc I17
    mov R10[I17], I9
    ret 3, I12, 0.0, null
9:  ret 1, 0, 0.0, 1n
.endf
