    bz I0, 422f
    mov R2, R0->MState.src
    sub I10, I0, 1
    mov I9, R2[I10]
422: mov I11, 0
    mov I12, R0->MState.slen
    bge I0, I12, 423f
    mov R2, R0->MState.src
    mov I11, R2[I0]
423: sub I13, I8, 1
    call pm$bracket (R0, I9, I1, I13) -> (I14)
    bnz I14, 424f
    call pm$bracket (R0, I11, I1, I13) -> (I14)
