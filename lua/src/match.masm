; Match pat from item p against src from s (0-based). With scan, try s,
; s + 1, ... up to the end of src, skipping a match that ends at last
; (-2 for none; gmatch and gsub skip an empty match where the previous one
; ended). Returns the end of the match (exclusive) and its start, or -1;
; the captures are in @pm$ms.
.func pm$run(ref src, ref pat, i64 s, i64 p, i64 scan, i64 last) -> (i64, i64)
    ; one MState serves every match: the matcher never runs Lua code, so
    ; it never runs twice at once
    mov R7, @pm$ms
    bnz R7, 100f
    new R7, MState
    lnew R8, 32
    resize R8, 32
    mov R7->MState.cs, R8
    lnew R9, 32
    resize R9, 32
    mov R7->MState.cl, R9
    mov @pm$ms, R7
100: mov R8, R7->MState.cs
    mov R9, R7->MState.cl
    mov R7->MState.src, R0
    len I7, R0
    mov R7->MState.slen, I7
    mov R7->MState.pat, R1
    len I8, R1
    mov R7->MState.plen, I8
    mov R12, @pm$cache
    bnz R12, 101f
    mnew R12
    mov @pm$cache, R12
101: mget.r R13, R12, R1, null
    bnz R13, 103f
    mov I24, @pm$ncache
    blt I24, 64, 102f
    mnew R12
    mov @pm$cache, R12
    mov I24, 0
102: inc I24
    mov @pm$ncache, I24
    new R13, PComp
    add I25, I8, 1
    lnew R14, I25
    resize R14, I25
    mov R13->PComp.ends, R14
