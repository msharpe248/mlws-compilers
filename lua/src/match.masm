    mov R2[I1], I8
501: mov I9, 0
    bge I8, I3, 51f
    mov I9, R1[I8]
51: mov I10, 0
    mov I15, R0->MState.slen
    bge I0, I15, 53f
    mov R2, R0->MState.sets
