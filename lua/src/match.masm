; ---------------------------------------------------------------------------
; Lua patterns (lua/src/match.masm): the matcher of lstrlib.c, and
; string.find, match and gmatch; gsub is in the prelude, on P.match.
; Positions are 0-based here; a failed match is -1.
; ---------------------------------------------------------------------------

.struct MState
    src: ref
    slen: i64
    pat: ref
    plen: i64
    level: i64
    depth: i64
    cs: ref             ; capture starts (a list of i64)
    cl: ref             ; capture lengths: -1 unfinished, -2 a position
    ends: ref           ; PComp's lists, for this pattern
    sets: ref
    kinds: ref
.ends

; A pattern, compiled as it is used: per position p of the pattern (and
; plen), the end of the item at p (0 if not yet known), its set of 256
; flags (null if not yet made) and whether a match must begin with a
; character in that set (0 not yet known, 1 no, 2 yes); and skip, whether
; a scan can skip a run (see pm$skip). Kept in @pm$cache, a map from
; pattern to PComp.
.struct PComp
    ends: ref
    sets: ref
    kinds: ref
    skip: i64
.ends

        .align 8
pm$cache:   .zero 8
pm$ncache:  .zero 8
pm$any:     .zero 8     ; the set of '.'
pm$ms:      .zero 8     ; the MState

; The end of the pattern item at p.
.func pm$class_end(ref ms, i64 p) -> i64
    mov R1, R0->MState.pat
    mov I1, R0->MState.plen
    mov I2, R1[I0]
    inc I0
    bne I2, '%', 2f
    bge I0, I1, 9f
    inc I0
    ret I0
2:  bne I2, '[', 5f
    bge I0, I1, 3f
    mov I3, R1[I0]
    bne I3, '^', 3f
    inc I0
3:  bge I0, I1, 8f
    mov I3, R1[I0]
    inc I0
    bne I3, '%', 4f
    bge I0, I1, 4f
    inc I0
4:  bge I0, I1, 3b
    mov I3, R1[I0]
    bne I3, ']', 3b
    inc I0
5:  ret I0
8:  call rt$rterror ("malformed pattern (missing ']')")
    ret 0
9:  call rt$rterror ("malformed pattern (ends with '%')")
    ret 0
.endf

        .align 8
pm$tables:  .zero 8     ; a list of 128 tables: for class letter cl, 256 flags

; The table of class %cl: a list of 256 integers, 1 for the characters in it.
.func pm$table(i64 cl) -> ref
    mov R0, @pm$tables
    bnz R0, 1f
    lnew R0, 128
    resize R0, 128
    mov @pm$tables, R0
1:  mov R1, R0[I0]
    bnz R1, 9f
    lnew R1, 256
    mov I1, 0
2:  call pm$class (I1, I0) -> (I2)
    lpush R1, I2
    inc I1
    blt I1, 256, 2b
    mov R0[I0], R1
9:  ret R1
.endf

; Does character c belong to class %cl?
.func pm$class(i64 c, i64 cl) -> i64
    or I2, I1, 32
    beq I2, 'a', 10f
    beq I2, 'c', 11f
    beq I2, 'd', 12f
    beq I2, 'g', 13f
    beq I2, 'l', 14f
    beq I2, 'p', 15f
    beq I2, 's', 16f
    beq I2, 'u', 17f
    beq I2, 'w', 18f
    beq I2, 'x', 19f
    seq I3, I0, I1
    ret I3
10: or I4, I0, 32
    mov I3, 0
    blt I4, 'a', 90f
    bgt I4, 'z', 90f
    mov I3, 1
    jmp 90f
11: mov I3, 1
    blt I0, 32, 90f
    beq I0, 127, 90f
    mov I3, 0
    jmp 90f
12: mov I3, 0
    blt I0, '0', 90f
    bgt I0, '9', 90f
    mov I3, 1
    jmp 90f
13: mov I3, 0
    blt I0, 33, 90f
    bgt I0, 126, 90f
    mov I3, 1
    jmp 90f
14: mov I3, 0
    blt I0, 'a', 90f
    bgt I0, 'z', 90f
    mov I3, 1
    jmp 90f
15: mov I3, 0
    blt I0, 33, 90f
    bgt I0, 126, 90f
    mov I3, 1
    blt I0, '0', 90f
    ble I0, '9', 151f
    blt I0, 'A', 90f
    ble I0, 'Z', 151f
    blt I0, 'a', 90f
    ble I0, 'z', 151f
    jmp 90f
151: mov I3, 0
    jmp 90f
16: mov I3, 1
    beq I0, 32, 90f
    blt I0, 9, 161f
    ble I0, 13, 90f
161: mov I3, 0
    jmp 90f
17: mov I3, 0
    blt I0, 'A', 90f
    bgt I0, 'Z', 90f
    mov I3, 1
    jmp 90f
18: mov I3, 1
    blt I0, '0', 181f
    ble I0, '9', 90f
181: or I4, I0, 32
    blt I4, 'a', 182f
    ble I4, 'z', 90f
182: mov I3, 0
    jmp 90f
19: mov I3, 1
    blt I0, '0', 191f
    ble I0, '9', 90f
191: or I4, I0, 32
    blt I4, 'a', 192f
    ble I4, 'f', 90f
192: mov I3, 0
90: blt I1, 'A', 91f
    bgt I1, 'Z', 91f
    xor I3, 1
91: ret I3
.endf

; Does c match the set [...] from p (its '[') to ec (its ']')?
.func pm$bracket(ref ms, i64 c, i64 p, i64 ec) -> i64
    mov R1, R0->MState.pat
    mov I3, 1               ; sig
    add I4, I1, 1
    mov I5, R1[I4]
    bne I5, '^', 1f
    mov I3, 0
    inc I1
1:  inc I1
    bge I1, I2, 8f
    mov I5, R1[I1]
    bne I5, '%', 2f
    inc I1
    mov I6, R1[I1]
    call pm$class (I0, I6) -> (I7)
    bnz I7, 9f
    jmp 1b
2:  add I4, I1, 1
    mov I6, R1[I4]
    bne I6, '-', 3f
    add I4, I1, 2
    bge I4, I2, 3f
    mov I6, R1[I4]
    mov I1, I4
    blt I0, I5, 1b
    bgt I0, I6, 1b
    jmp 9f
3:  beq I5, I0, 9f
    jmp 1b
8:  xor I3, 1
9:  ret I3
.endf

; Does the character at s match the single item p .. ep?
.func pm$single(ref ms, i64 s, i64 p, i64 ep) -> i64
    mov I3, R0->MState.slen
    bge I0, I3, 8f
    mov R2, R0->MState.sets
    mov R3, R2[I1]
    bnz R3, 1f
    call pm$set (R0, I1, I2) -> (R3)
1:  mov R1, R0->MState.src
    mov I4, R1[I0]
    mov I5, R3[I4]
    ret I5
8:  ret 0
.endf

; The set of the single item p .. ep: 256 flags, 1 for each character it
; matches. Made once per pattern and position.
.func pm$set(ref ms, i64 p, i64 ep) -> ref
    mov R1, R0->MState.pat
    mov I2, R1[I0]
    bne I2, '.', 2f
    mov R2, @pm$any
    bnz R2, 9f
    lnew R2, 256
    mov I3, 0
    mov I4, 1
1:  lpush R2, I4
    inc I3
    blt I3, 256, 1b
    mov @pm$any, R2
    jmp 9f
2:  bne I2, '%', 3f
    add I3, I0, 1
    mov I3, R1[I3]
    bge I3, 128, 5f
    call pm$table (I3) -> (R2)
    jmp 9f
3:  bne I2, '[', 4f
    lnew R2, 256
    sub I4, I1, 1
    mov I3, 0
31: call pm$bracket (R0, I3, I0, I4) -> (I5)
    lpush R2, I5
    inc I3
    blt I3, 256, 31b
    jmp 9f
4:  mov I3, I2
5:  lnew R2, 256
    resize R2, 256
    mov I5, 1
    mov R2[I3], I5
9:  mov R3, R0->MState.sets
    mov R3[I0], R2
    ret R2
.endf

; If a match of the pattern from p must begin with a character of one set
; (its first item is a single one, without '*', '?' or '-'), that set;
; otherwise null.
.func pm$req(ref ms, i64 p) -> ref
    mov R1, R0->MState.kinds
    mov I1, R1[I0]
    beq I1, 2, 7f
    beq I1, 1, 8f
    mov R2, R0->MState.pat
    mov I2, R0->MState.plen
    mov I3, 1
    bge I0, I2, 6f
    mov I4, R2[I0]
    beq I4, '(', 6f
    beq I4, ')', 6f
    bne I4, '$', 1f
    add I5, I0, 1
    beq I5, I2, 6f
1:  bne I4, '%', 2f
    add I5, I0, 1
    bge I5, I2, 2f
    mov I6, R2[I5]
    beq I6, 'b', 6f
    beq I6, 'f', 6f
    blt I6, '0', 2f
    ble I6, '9', 6f
2:  mov R3, R0->MState.ends
    mov I7, R3[I0]
    bnz I7, 3f
    call pm$class_end (R0, I0) -> (I7)
    mov R3[I0], I7
3:  bge I7, I2, 4f
    mov I6, R2[I7]
    beq I6, '*', 6f
    beq I6, '?', 6f
    beq I6, '-', 6f
4:  mov R3, R0->MState.sets
    mov R4, R3[I0]
    bnz R4, 5f
    call pm$set (R0, I0, I7) -> (R4)
5:  mov I3, 2
6:  mov R1[I0], I3
    beq I3, 1, 8f
7:  mov R3, R0->MState.sets
    mov R4, R3[I0]
    ret R4
8:  ret null
.endf

; Can a scan for the pattern skip a run? 2 if the pattern has no captures
; and begins with an item x+ or x*: then a match from s tries the rest of
; the pattern at every position of the run of x's from s (or s + 1), so if
; it fails, a match from inside the run fails as well, and if it ends at
; the last match, a match from inside the run ends there too or fails.
; 1 otherwise.
.func pm$skip(ref ms) -> i64
    mov R1, R0->MState.pat
    mov I1, R0->MState.plen
    mov I2, 0
1:  bge I2, I1, 2f
    mov I3, R1[I2]
    beq I3, '(', 8f
    inc I2
    jmp 1b
2:  bz I1, 8f
    mov I2, 0
    mov I3, R1[I2]
    beq I3, ')', 8f
    bne I3, '$', 3f
    beq I1, 1, 8f
3:  bne I3, '%', 4f
    blt I1, 2, 4f
    mov I2, 1
    mov I4, R1[I2]
    beq I4, 'b', 8f
    beq I4, 'f', 8f
    blt I4, '0', 4f
    ble I4, '9', 8f
4:  mov I2, 0
    mov R2, R0->MState.ends
    mov I5, R2[I2]
    bnz I5, 5f
    call pm$class_end (R0, I2) -> (I5)
    mov R2[I2], I5
5:  bge I5, I1, 8f
    mov I6, R1[I5]
    beq I6, '+', 6f
    bne I6, '*', 8f
6:  mov R3, R0->MState.sets
    mov R4, R3[I2]
    bnz R4, 7f
    call pm$set (R0, I2, I5) -> (R4)
7:  ret 2
8:  ret 1
.endf

.func pm$max_expand(ref ms, i64 s, i64 p, i64 ep) -> i64
    mov R1, R0->MState.src
    mov I7, R0->MState.slen
    ; I4: past the longest run of characters that match the item
    mov R2, R0->MState.pat
    mov I8, R2[I1]
    bne I8, '.', 1f
    mov I4, I7
    max I4, I0
    jmp 3f
1:  mov R2, R0->MState.sets
    mov R3, R2[I1]
    bnz R3, 11f
    call pm$set (R0, I1, I2) -> (R3)
11: mov I4, I0
2:  bge I4, I7, 3f
    mov I5, R1[I4]
    mov I6, R3[I5]
    bz I6, 3f
    inc I4
    jmp 2b
3:  ; try the rest of the pattern after the longest run, then shorter ones,
    ; skipping those where the rest's first character cannot match
    add I6, I2, 1
    call pm$req (R0, I6) -> (R4)
    bz R4, 5f
4:  blt I4, I0, 9f
    bge I4, I7, 41f
    mov I5, R1[I4]
    mov I9, R4[I5]
    bz I9, 41f
    call pm$do (R0, I4, I6) -> (I5)
    bge I5, 0, 8f
41: dec I4
    jmp 4b
5:  blt I4, I0, 9f
    call pm$do (R0, I4, I6) -> (I5)
    bge I5, 0, 8f
    dec I4
    jmp 5b
8:  ret I5
9:  ret -1
.endf

.func pm$min_expand(ref ms, i64 s, i64 p, i64 ep) -> i64
    add I6, I2, 1
1:  call pm$do (R0, I0, I6) -> (I5)
    bge I5, 0, 8f
    call pm$single (R0, I0, I1, I2) -> (I4)
    bz I4, 9f
    inc I0
    jmp 1b
8:  ret I5
9:  ret -1
.endf

.func pm$start_capture(ref ms, i64 s, i64 p, i64 what) -> i64
    mov I3, R0->MState.level
    blt I3, 32, 1f
    call rt$rterror ("too many captures")
1:  mov R1, R0->MState.cs
    mov R1[I3], I0
    mov R1, R0->MState.cl
    mov R1[I3], I2
    add I4, I3, 1
    mov R0->MState.level, I4
    call pm$do (R0, I0, I1) -> (I5)
    bge I5, 0, 2f
    mov R0->MState.level, I3
2:  ret I5
.endf

.func pm$end_capture(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.level
    mov R1, R0->MState.cl
1:  dec I2
    blt I2, 0, 8f
    mov I3, R1[I2]
    bne I3, -1, 1b
    mov R2, R0->MState.cs
    mov I4, R2[I2]
    sub I5, I0, I4
    mov R1[I2], I5
    call pm$do (R0, I0, I1) -> (I6)
    bge I6, 0, 2f
    mov R1[I2], -1
2:  ret I6
8:  call rt$rterror ("invalid pattern capture")
    ret -1
.endf

.func pm$balance(ref ms, i64 s, i64 p) -> i64
    mov I2, R0->MState.plen
    add I3, I1, 1
    blt I3, I2, 1f
    call rt$rterror ("malformed pattern (missing arguments to '%b')")
1:  mov I4, R0->MState.slen
    bge I0, I4, 9f
    mov R1, R0->MState.src
    mov R2, R0->MState.pat
    mov I5, R2[I1]          ; b
    mov I6, R2[I3]          ; e
    mov I7, R1[I0]
    bne I7, I5, 9f
    mov I8, 1
2:  inc I0
    bge I0, I4, 9f
    mov I7, R1[I0]
    bne I7, I6, 3f
    dec I8
    bnz I8, 2b
    inc I0
    ret I0
3:  bne I7, I5, 2b
    inc I8
    jmp 2b
9:  ret -1
.endf

.func pm$match_capture(ref ms, i64 s, i64 l) -> i64
    sub I1, '1'
    blt I1, 0, 8f
    mov I2, R0->MState.level
    bge I1, I2, 8f
    mov R1, R0->MState.cl
    mov I3, R1[I1]
    beq I3, -1, 8f
    mov R2, R0->MState.cs
    mov I4, R2[I1]
    mov I5, R0->MState.slen
    sub I6, I5, I0
    blt I6, I3, 9f
    mov R3, R0->MState.src
    mov I7, 0
1:  bge I7, I3, 2f
    add I8, I4, I7
    mov I9, R3[I8]
    add I8, I0, I7
    mov I10, R3[I8]
    bne I9, I10, 9f
    inc I7
    jmp 1b
2:  add I0, I3
    ret I0
8:  add I1, 1
    tostr R4, I1
    strcat R5, "invalid capture index %", R4
    call rt$rterror (R5)
