#!/bin/sh
# Compile a Lua program with mlws-vm-luac and run it on MLWSVM.
#
#   mlws-vm-lua [options] program.lua [args...]
#     -S           only compile: write the assembly (.masm) and do not run it
#     -k           keep the assembly after running it
#     -g           name the program's local variables for MLWSVM's debuggers
#                  (mlwsvm debug, mlwsvm dap; MLWSVM 0.17.3 or later)
#     -d           run the program in MLWSVM's debugger (mlwsvm debug),
#                  which reads its commands from standard input; implies -g
#     -o FILE      the assembly file (default: program.masm next to the
#                  source); with -S, '-' writes it to standard output
#     --shared     compile the program alone, importing the runtime from the
#                  MLWSVM library lua (lib/lua-VERSION.mlwsl, made by
#                  `make lib`), instead of one self-contained file
#     -b FILE, --bundle FILE
#                  write one executable, FILE, holding the VM and the
#                  program (optimized at --opt 3, the JIT on) instead of
#                  running it; it runs with no MLWSVM beside it (MLWSVM
#                  0.17.0 or later)
#     --version    print the compiler's version
#
# The VM is found as $MLWSVM, then mlwsvm on PATH, then ../mlws-vm/mlwsvm
# next to this repository.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
usage() {
    echo "usage: mlws-vm-lua [--version] [-g] [-d | -b FILE] [--shared] [-S | -k] [-o FILE] program.lua [args...]" >&2
    exit 64
}

compile_only= keep= out= prog= bundle= shared= debug= g=
while [ $# -gt 0 ]; do
    case "$1" in
        -S) compile_only=1; shift ;;
        --shared) shared=--shared; shift ;;
        -k) keep=1; shift ;;
        -g) g=-g; shift ;;
        -d) debug=1; g=-g; shift ;;
        -b|--bundle) [ $# -ge 2 ] || usage; bundle=$2; shift 2 ;;
        -o) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
        --version) exec "$here/mlws-vm-luac" --version ;;
        -h|--help) usage ;;
        -*) usage ;;
        *) prog=$1; shift; break ;;
    esac
done
[ -n "$prog" ] || usage
[ -z "$bundle" ] || { [ $# -eq 0 ] && [ -z "$compile_only" ]; } || usage
[ -z "$debug" ] || { [ $# -eq 0 ] && [ -z "$compile_only" ] && [ -z "$bundle" ]; } || usage

if [ -n "$compile_only" ] || [ -n "$keep" ] || [ -n "$out" ]; then
    [ -n "$out" ] || out="${prog%.*}.masm"
    if [ "$out" = "-" ] && [ -z "$compile_only" ]; then
        echo "mlws-vm-lua: -o - (standard output) needs -S" >&2
        exit 64
    fi
else
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/lua.XXXXXX") || exit 1
    trap 'rm -rf "$tmp"' EXIT INT TERM
    out="$tmp/program.masm"
fi
"$here/mlws-vm-luac" $g $shared -o "$out" "$prog" || exit $?
[ -n "$compile_only" ] && exit 0

. "$here/../tools/find-vm.sh"
if [ -n "$shared" ]; then
    lib="$here/lib/lua-$("$here/mlws-vm-luac" --version | sed 's/.* //').mlwsl"
    if [ ! -f "$lib" ]; then
        echo "mlws-vm-lua: no library $lib (make it with make -C $here lib)" >&2
        exit 69
    fi
    if [ -n "$bundle" ]; then
        "$MLWSVM" bundle -L "$here/lib" -o "$bundle" --opt 3 --jit on "$out"
        exit $?
    fi
    if [ -n "$debug" ]; then
        "$MLWSVM" debug -L "$here/lib" "$out"
        exit $?
    fi
    "$MLWSVM" run -L "$here/lib" "$out" "$@"
    exit $?
fi
if [ -n "$bundle" ]; then
    "$MLWSVM" bundle -o "$bundle" --opt 3 --jit on "$out"
    exit $?
fi
if [ -n "$debug" ]; then
    "$MLWSVM" debug "$out"
    exit $?
fi
"$MLWSVM" run "$out" "$@"
