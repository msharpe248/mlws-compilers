#!/bin/sh
# Compile a brainfuck program with mlws-vm-bfc and run it on MLWSVM.
#
#   mlws-vm-bf [options] program.b [args...]
#     -S           only compile: write the assembly (.masm) and do not run it
#     -k           keep the assembly after running it
#     -o FILE      the assembly file (default: program.masm next to the
#                  source); with -S, '-' writes it to standard output
#     -b FILE, --bundle FILE
#                  write one executable, FILE, holding the VM and the
#                  program (optimized at --opt 3, the JIT on) instead of
#                  running it; it runs with no MLWSVM beside it (MLWSVM
#                  0.17.0 or later)
#     --version    print the compiler's version
#     --tape N, --eof MODE, -O0
#                  passed to mlws-vm-bfc (see mlws-vm-bfc --help)
#
# The VM is found as $MLWSVM, then mlwsvm on PATH, then ../mlws-vm/mlwsvm
# next to this repository.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
usage() {
    echo "usage: mlws-vm-bf [--version] [-b FILE] [-S | -k] [-o FILE] [--tape N] [--eof unchanged|zero|minus1] [-O0] program.b [args...]" >&2
    exit 2
}

opts= compile_only= keep= out= prog= bundle=
while [ $# -gt 0 ]; do
    case "$1" in
        -S) compile_only=1; shift ;;
        -k) keep=1; shift ;;
        -b|--bundle) [ $# -ge 2 ] || usage; bundle=$2; shift 2 ;;
        -o) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
        --tape|--eof) [ $# -ge 2 ] || usage; opts="$opts $1 $2"; shift 2 ;;
        -O0) opts="$opts $1"; shift ;;
        --version) exec "$here/mlws-vm-bfc" --version ;;
        -h|--help) usage ;;
        -*) usage ;;
        *) prog=$1; shift; break ;;
    esac
done
[ -n "$prog" ] || usage
[ -z "$bundle" ] || { [ $# -eq 0 ] && [ -z "$compile_only" ]; } || usage

if [ -n "$compile_only" ] || [ -n "$keep" ] || [ -n "$out" ]; then
    [ -n "$out" ] || out="${prog%.*}.masm"
    if [ "$out" = "-" ] && [ -z "$compile_only" ]; then
        echo "mlws-vm-bf: -o - (standard output) needs -S" >&2
        exit 2
    fi
else
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/bf.XXXXXX") || exit 1
    trap 'rm -rf "$tmp"' EXIT INT TERM
    out="$tmp/program.masm"
fi
"$here/mlws-vm-bfc" $opts -o "$out" "$prog" || exit $?
[ -n "$compile_only" ] && exit 0

. "$here/../tools/find-vm.sh"
if [ -n "$bundle" ]; then
    "$MLWSVM" bundle -o "$bundle" --opt 3 --jit on "$out"
    exit $?
fi
"$MLWSVM" run "$out" "$@"
