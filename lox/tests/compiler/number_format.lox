print 1000000; // expect: 1000000
print 123456789012; // expect: 123456789012
print 0.5; // expect: 0.5
print -3; // expect: -3
print 1 / 3; // expect: 0.3333333333333333
print 1000000000000000000000 * 1000000000000000000000; // expect: 1e+42
print 2 * 0.1; // expect: 0.2
print -0; // expect: -0
print 0 * -1; // expect: -0
print 100000000000000000000; // expect: 1e+20
