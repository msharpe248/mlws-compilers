    bne I8, 32, fail
9:  sar I8, I8, 3
    bgt I8, I6, fail
    add I10, I4, off
    mov I11, 0
    mov I12, 0
    and I13, flags, 2
10: bge I12, I8, 12f
    bnz I13, 11f
    add I14, I10, I12
    jmp 13f
11: add I14, I10, I8
    sub I14, I12
    dec I14
13: mov.u8 I15, R3[I14]
    shl I11, I11, 8
    or I11, I15
    inc I12
    jmp 10b
12: add I16, off, I8
    beq I8, 8, 14f
    bitcast.f32.u32 F1, I11
    cvt.f64.f32 F0, F1
    bitcast.i64.f64 I11, F0
14: ret 1, I11, I16, 1d
