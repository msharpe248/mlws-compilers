    tcall rt$str_to_int (R1)
.endf

; float_to_list/1: "1.00000000000000000000e+00"
.func rt$float_to_list(i64 a, ref ar) -> (i64, ref)
    bne.r ar, 1d, 9f
    bitcast.f64.i64 F0, a
    lnew R1, 1
    lpush R1, F0
    ncall "text.format" ("{:.20e}", R1) -> R2
    tcall rt$str_to_list (R2)
9:  tcall rt$badarg ()
.endf

; The shortest string that reads back as the float (VM format), as an atom-like value.
.func rt$float_str(i64 a, ref ar) -> (i64, ref)
