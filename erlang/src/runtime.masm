    bge I11, 0, 6b
    cvt.big.u64 R5, I11
    ret 1, 0, I16, R5
bin:
    blt size, 0, 7f
    mul I8, size, unit
    and I9, I8, 7
    bnz I9, fail
    sar I8, I8, 3
    bgt I8, I6, fail
    jmp 8f
7:  mov I8, I6
8:  new R5, Bin
    mov.r R5->Bin.data, R3
    add I10, I4, off
    mov R5->Bin.off, I10
    mov R5->Bin.len, I8
    add I16, off, I8
    ret 1, 0, I16, R5
flt:
