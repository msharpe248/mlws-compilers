    mov I11, 0                      ; value
    mov I12, 0
    and I13, flags, 2
1:  bge I12, I8, 3f
    bnz I13, 2f
    add I14, I10, I12
    jmp 4f
2:  add I14, I10, I8
    sub I14, I12
    dec I14
4:  mov.u8 I15, R3[I14]
    shl I11, I11, 8
    or I11, I15
    inc I12
    jmp 1b
3:  add I16, off, I8
    and I13, flags, 1
    bz I13, 5f
