1:  beq.r l, 0d, 2f
    mov.r R3, l->Cons.hr
    mov I3, l->Cons.hi
    lpush R2, R3, I3
    mov.r l, l->Cons.tr
    jmp 1b
2:  ret 0, R2
.endf

.func rt$make_tuple(i64 n, i64 v, ref nr, ref vr) -> (i64, ref)
