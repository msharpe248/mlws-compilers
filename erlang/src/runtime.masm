    add I6, 2
    jmp 1b
2:  lpush R3, vr, v
    add I6, 2
    jmp 1b
3:  ret 0, R3
9:  tcall rt$badarg ()
.endf

.func rt$tuple_size(i64 a, ref t) -> (i64, ref)
    call rt$tsize (t) -> I1
    blt I1, 0, 9f
    ret I1, null
9:  tcall rt$badarg ()
.endf

.func rt$size(i64 a, ref t) -> (i64, ref)
