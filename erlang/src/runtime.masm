; ======================================================================
; The runtime of mlws-vm-erlc: Erlang terms, BIFs, processes and messages.
;
; A term is a pair (I, R) (see gen.c): R null is a small integer in I;
; R == 1d a float, its bits in I; R == 0d is []; R a string is an atom;
; R a BigInt an integer that does not fit in 64 bits; R a list a tuple
; (two words per element, R then I); R a struct one of those below.
; Functions with the value convention take (i64 a1.., ref a1..) and
; return (i64, ref).
; ======================================================================

.struct Cons
    hi: i64
    hr: ref
    ti: i64
    tr: ref
.ends

.struct Pid
    id: i64
.ends

; A process's messages received but not yet taken (fields, not globals, as
; the VM's fast forms store to fields)
.struct Mbox
    saved: ref      ; a list, R and I each
    scan: i64       ; the next saved message a receive looks at
.ends

.struct Ref
    a: i64
    b: i64
.ends

.struct Fun
    arity: i64
    clo: ref        ; a closure with the value convention
    name: ref       ; a string, for printing
.ends

.struct Map
    kv: ref         ; up to 32 keys: a list, key R, key I, value R, value I, ... sorted by key
    tree: ref       ; more: a red-black tree of erts_map (kv is null)
    size: i64       ; the number of keys in the tree
.ends

.struct Bin
    data: ref       ; a byte buffer, never changed once the binary is made
    off: i64
    len: i64
.ends

.struct Exc
    cls: ref        ; error, exit or throw
    ri: i64         ; the reason
    rr: ref
    stk: ref        ; the stack trace (a list)
.ends

; Each process has its own copy of these.
g$mbox:     .zero 8      ; an Mbox, made by the first receive
g$self:     .zero 8      ; this process's Pid
g$monitors: .zero 8      ; a map: pid -> the Ref of our monitor of it
g$links:    .zero 8      ; a map: pid -> 1, links made while trapping exits
g$trap:     .i64 0       ; trap_exit
g$refn:     .i64 0       ; references made
g$pdict:    .zero 8      ; the process dictionary (a Map term)
g$atomtab:  .zero 8      ; atoms made at run time: a map string -> the atom
g$start:    .zero 8      ; the closure a new process runs, for rt$proc_start
g$dispatch: .zero 8      ; apply/3: "m:f/n" -> adapter closure
g$uniq:     .i64 0

; ---------------------------------------------------------------- exceptions

.func rt$raise(i64 ri, ref cls, ref rr) -> (i64, ref)
    new R2, Exc
    mov.r R2->Exc.cls, cls
    mov R2->Exc.ri, ri
    mov.r R2->Exc.rr, rr
    mov.r R2->Exc.stk, 0d
    throw R2
.endf

.func rt$error(i64 ri, ref rr) -> (i64, ref)
    tcall rt$raise (ri, "error", rr)
.endf

.func rt$throw(i64 ri, ref rr) -> (i64, ref)
    tcall rt$raise (ri, "throw", rr)
.endf

.func rt$exit(i64 ri, ref rr) -> (i64, ref)
    tcall rt$raise (ri, "exit", rr)
.endf

.func rt$badarg -> (i64, ref)
    tcall rt$raise (0, "error", "badarg")
.endf

.func rt$badarith -> (i64, ref)
    tcall rt$raise (0, "error", "badarith")
.endf

; error({Tag, Value})
.func rt$error2(i64 vi, ref tag, ref vr) -> (i64, ref)
    lnew R2, 4
    lpush R2, tag, 0, vr, vi
    tcall rt$raise (0, "error", R2)
.endf

; The class, reason and stack of a caught exception. A fault of the VM
; becomes an error: E_DIV_ZERO badarith, and so on.
.func rt$exc_info(ref e) -> (i64, ref, ref, ref)
    bnisa e, Exc, 1f
    mov I0, e->Exc.ri
    mov.r R1, e->Exc.cls
    mov.r R2, e->Exc.rr
    mov.r R3, e->Exc.stk
    ret I0, R1, R2, R3
1:  bnisa e, Error, 2f
    mov.r R1, e->Error.code
    call rt$vm_reason (R1) -> (I0, R2, R3)
    ret I0, R3, R2, 0d
2:  ret 0, "error", "unknown", 0d
.endf

; A VM error code as an Erlang reason and class.
.func rt$vm_reason(ref code) -> (i64, ref, ref)
    strcmp I0, code, "E_DIV_ZERO"
    bnz I0, 1f
    ret 0, "badarith", "error"
1:  strcmp I0, code, "E_KILLED"
    bnz I0, 2f
    ret 0, "killed", "exit"
2:  strcmp I0, code, "E_LINKED"
    bnz I0, 3f
    ret 0, "killed", "exit"
3:  strcmp I0, code, "E_CALL_DEPTH"
    bnz I0, 4f
    ret 0, "system_limit", "error"
4:  strcmp I0, code, "E_QUOTA"
    bnz I0, 5f
    ret 0, "system_limit", "error"
5:  strcmp I0, code, "E_NOPROC"
    bnz I0, 6f
    ret 0, "noproc", "exit"
6:  strcmp I0, code, "E_LINK_UNDEF"   ; a handle whose function a reload dropped
    bnz I0, 7f
    ret 0, "undef", "error"
7:  ret 0, "badarg", "error"
.endf

; catch Expr: the value of an exception.
.func rt$catch_value(ref e) -> (i64, ref)
    call rt$exc_info (e) -> (I0, R1, R2, R3)
    beq.r R1, "throw", 1f
    beq.r R1, "exit", 2f
    lnew R4, 4
    lpush R4, R2, I0, R3, 0
    lnew R5, 4
    lpush R5, "EXIT", 0, R4, 0
    ret 0, R5
1:  ret I0, R2
2:  lnew R5, 4
    lpush R5, "EXIT", 0, R2, I0
    ret 0, R5
.endf

.func rt$function_clause(i64 ni, i64 ai, ref nr, ref ar) -> (i64, ref)
    tcall rt$raise (0, "error", "function_clause")
.endf

.func rt$undef(i64 mi, i64 fi, i64 n, ref mr, ref fr, ref nr) -> (i64, ref)
    tcall rt$raise (0, "error", "undef")
.endf

; A call of something that is not a fun of the right arity.
.func rt$badfun(i64 fi, i64 ai, ref fr, ref ar) -> (i64, ref)
    bnisa fr, Fun, 1f
    ; {badarity, {Fun, Args}}
    lnew R2, 4
    lpush R2, fr, fi, ar, ai
    lnew R3, 4
    lpush R3, "badarity", 0, R2, 0
    tcall rt$raise (0, "error", R3)
1:  lnew R3, 4
    lpush R3, "badfun", 0, fr, fi
    tcall rt$raise (0, "error", R3)
.endf

; ---------------------------------------------------------------- numbers

; 0 a small integer, 1 a BigInt, 2 a float, 3 not a number
.func rt$numkind(ref r) -> i64
    bnz r, 1f
    ret 0
1:  beq.r r, 1d, 2f
    typeof I0, r
    bne I0, 8, 3f
    ret 1
2:  ret 2
3:  ret 3
.endf

.func rt$tobig(i64 a, ref r) -> ref
    bnz r, 1f
    cvt.big.i64 R1, a
    ret R1
1:  ret r
.endf

; A BigInt as a term: a small integer if it fits.
.func rt$norm(ref b) -> (i64, ref)
    blt.big b, -9223372036854775808n, 1f
    bgt.big b, 9223372036854775807n, 1f
    cvt.i64.big I0, b
    ret I0, null
1:  ret 0, b
.endf

.func rt$tof(i64 a, ref r) -> f64
    bnz r, 1f
    cvt.f64.i64 F0, a
    ret F0
1:  beq.r r, 1d, 2f
    cvt.f64.big F0, r
    ret F0
2:  bitcast.f64.i64 F0, a
    ret F0
.endf

; A float result: badarith unless it is finite.
.func rt$fres(f64 x) -> (i64, ref)
    sub F1, x, x
    bne F1, 0.0, 1f
    bitcast.i64.f64 I0, x
    ret I0, 1d
1:  tcall rt$badarith ()
.endf

; Both numbers? I2/I3 are their kinds; jump to 9f if not.
.macro NUMKINDS
    call rt$numkind (R0) -> I2
    call rt$numkind (R1) -> I3
    bge I2, 3, 9f
    bge I3, 3, 9f
.endm

.func rt$add(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    beq I2, 2, 2f
    beq I3, 2, 2f
    call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    add.big R4, R2, R3
    tcall rt$norm (R4)
2:  call rt$tof (a, ar) -> F0
    call rt$tof (b, br) -> F1
    add F2, F0, F1
    tcall rt$fres (F2)
9:  tcall rt$badarith ()
.endf

.func rt$sub(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    beq I2, 2, 2f
    beq I3, 2, 2f
    call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    sub.big R4, R2, R3
    tcall rt$norm (R4)
2:  call rt$tof (a, ar) -> F0
    call rt$tof (b, br) -> F1
    sub F2, F0, F1
    tcall rt$fres (F2)
9:  tcall rt$badarith ()
.endf

.func rt$mul(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    beq I2, 2, 2f
    beq I3, 2, 2f
    call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    mul.big R4, R2, R3
    tcall rt$norm (R4)
2:  call rt$tof (a, ar) -> F0
    call rt$tof (b, br) -> F1
    mul F2, F0, F1
    tcall rt$fres (F2)
9:  tcall rt$badarith ()
.endf

.func rt$fdiv(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    call rt$tof (a, ar) -> F0
    call rt$tof (b, br) -> F1
    beq F1, 0.0, 9f
    div F2, F0, F1
    tcall rt$fres (F2)
9:  tcall rt$badarith ()
.endf

.func rt$idiv(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    bge I2, 2, 9f
    bge I3, 2, 9f
    bnz I2, 1f
    bnz I3, 1f
    beq b, 0, 9f
    bne b, -1, 2f
    blt a, -9223372036854775807, 1f
    neg I4, a
    ret I4, null
2:  div I4, a, b
    ret I4, null
1:  call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    beq.big R3, 0n, 9f
    div.big R4, R2, R3
    tcall rt$norm (R4)
9:  tcall rt$badarith ()
.endf

.func rt$irem(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    NUMKINDS
    bge I2, 2, 9f
    bge I3, 2, 9f
    bnz I2, 1f
    bnz I3, 1f
    beq b, 0, 9f
    bne b, -1, 2f
    ret 0, null
2:  rem I4, a, b
    ret I4, null
1:  call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    beq.big R3, 0n, 9f
    rem.big R4, R2, R3
    tcall rt$norm (R4)
9:  tcall rt$badarith ()
.endf

; Bitwise operations work on small integers only.
.macro SMALL2
    bnz R0, 9f
    bnz R1, 9f
.endm

.func rt$band(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    SMALL2
    and I2, a, b
    ret I2, null
9:  tcall rt$badarith ()
.endf

.func rt$bor(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    SMALL2
    or I2, a, b
    ret I2, null
9:  tcall rt$badarith ()
.endf

.func rt$bxor(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    SMALL2
    xor I2, a, b
    ret I2, null
9:  tcall rt$badarith ()
.endf

; 2^n as a BigInt
.func rt$pow2(i64 n) -> ref
    mov.r R0, 1n
    mov.r R1, 2n
1:  bz n, 3f
    and I1, n, 1
    bz I1, 2f
    mul.big R0, R0, R1
2:  mul.big R1, R1, R1
    sar n, n, 1
    jmp 1b
3:  ret R0
.endf

.func rt$bsl(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 2, 9f
    bnz br, 9f
    blt b, 0, 5f
    bnz I2, 3f
    bge b, 63, 3f
    shl I3, a, b
    sar I4, I3, b
    bne I4, a, 3f
    ret I3, null
3:  bgt b, 100000000, 9f
    call rt$tobig (a, ar) -> R2
    call rt$pow2 (b) -> R3
    mul.big R4, R2, R3
    tcall rt$norm (R4)
5:  neg I5, b
    tcall rt$bsr (a, I5, ar, null)
9:  tcall rt$badarith ()
.endf

.func rt$bsr(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 2, 9f
    bnz br, 9f
    blt b, 0, 5f
    bnz I2, 3f
    blt b, 63, 1f
    sar I3, a, 63
    ret I3, null
1:  sar I3, a, b
    ret I3, null
3:  ; floor(a / 2^b)
    call rt$pow2 (b) -> R3
    div.big R4, ar, R3
    bge.big ar, 0n, 4f
    mul.big R5, R4, R3
    beq.big R5, ar, 4f
    sub.big R4, R4, 1n
4:  tcall rt$norm (R4)
5:  neg I5, b
    tcall rt$bsl (a, I5, ar, null)
9:  tcall rt$badarith ()
.endf

.func rt$bnot(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 2, 9f
    bnz I2, 1f
    not I3, a
    ret I3, null
1:  neg.big R2, ar
    sub.big R2, R2, 1n
    tcall rt$norm (R2)
9:  tcall rt$badarith ()
.endf

.func rt$plus(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 3, 9f
    ret a, ar
9:  tcall rt$badarith ()
.endf

.func rt$abs(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I2
    jtab I2, 1f, 2f, 3f
    tcall rt$badarg ()
1:  bge a, 0, 4f
    tcall rt$sub (0, a, null, null)
4:  ret a, null
2:  abs.big R2, ar
    ret 0, R2
3:  bitcast.f64.i64 F0, a
    abs F0
    bitcast.i64.f64 I3, F0
    ret I3, 1d
.endf

.func rt$float(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 3, 9f
    call rt$tof (a, ar) -> F0
    tcall rt$fres (F0)
9:  tcall rt$badarg ()
.endf

; trunc, round, floor and ceil of a number: integers as they are
.macro FROUND name, op
.func rt$\name(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I2
    bge I2, 3, 9f
    bne I2, 2, 1f
    bitcast.f64.i64 F0, a
    \op F0
    tcall rt$f2int (F0)
1:  ret a, ar
9:  tcall rt$badarg ()
.endf
.endm

FROUND trunc, trunc
FROUND round, round
FROUND floor, floor
FROUND ceil, ceil

; An integral float as an integer (a BigInt if need be).
.func rt$f2int(f64 x) -> (i64, ref)
    blt x, -9.2e18, 1f
    bgt x, 9.2e18, 1f
    cvt.i64.f64 I0, x
    ret I0, null
1:  cvt.big.f64 R0, x
    ret 0, R0
.endf

; ---------------------------------------------------------------- the term order

; number < atom < reference < fun < port < pid < tuple < map < [] < list < binary
.func rt$rank(ref r) -> i64
    bz r, 1f
    beq.r r, 1d, 1f
    beq.r r, 0d, 8f
    typeof I0, r
    beq I0, 1, 2f
    beq I0, 5, 6f
    beq I0, 8, 1f
    bisa r, Cons, 9f
    bisa r, Pid, 5f
    bisa r, Ref, 3f
    bisa r, Fun, 4f
    bisa r, Map, 7f
    bisa r, Bin, 10f
    ret 11
1:  ret 0
2:  ret 1
3:  ret 2
4:  ret 3
5:  ret 5
6:  ret 6
7:  ret 7
8:  ret 8
9:  ret 9
10: ret 10
.endf

; Compare two terms: -1, 0 or 1. Exact: an integer and a float are never
; equal, and floats compare by their bits (0.0 and -0.0 differ).
.func rt$compare(i64 a, i64 b, i64 exact, ref ar, ref br) -> i64
    beq.r ar, br, same
diff:
    call rt$rank (ar) -> I3
    call rt$rank (br) -> I4
    beq I3, I4, 1f
    blt I3, I4, lt
    ret 1
lt: ret -1
same:
    beq a, b, eq
    bnz.r ar, diff
    blt a, b, lt        ; two small integers
    ret 1
eq: ret 0
1:  jtab I3, Lnum, Latom, Lref, Lfun, eq, Lpid, Ltuple, Lmap, eq, Llist, Lbin
    ret 0
Lnum:
    tcall rt$cmpnum (a, b, exact, ar, br)
Latom:
    strcmp I5, ar, br
    ret I5
Lref:
    mov I5, ar->Ref.a
    mov I6, br->Ref.a
    blt I5, I6, lt
    bgt I5, I6, gt
    mov I5, ar->Ref.b
    mov I6, br->Ref.b
    blt I5, I6, lt
    bgt I5, I6, gt
    ret 0
gt: ret 1
Lfun:
    mov.r R2, ar->Fun.name
    mov.r R3, br->Fun.name
    strcmp I5, R2, R3
    ret I5
Lpid:
    mov I5, ar->Pid.id
    mov I6, br->Pid.id
    blt I5, I6, lt
    bgt I5, I6, gt
    ret 0
Ltuple:
    len I5, ar
    len I6, br
    blt I5, I6, lt
    bgt I5, I6, gt
    mov I7, 0
2:  bge I7, I5, eq
    mov.r R2, ar[I7]
    mov.r R3, br[I7]
    add I8, I7, 1
    mov I9, ar[I8]
    mov I10, br[I8]
    call rt$compare (I9, I10, exact, R2, R3) -> I11
    bnz I11, 3f
    add I7, 2
    jmp 2b
3:  ret I11
Lmap:
    call rt$map_kv (ar) -> R2
    call rt$map_kv (br) -> R3
    len I5, R2
    len I6, R3
    blt I5, I6, lt
    bgt I5, I6, gt
    ; the keys, then the values
    mov I7, 0
4:  bge I7, I5, 5f
    mov.r R4, R2[I7]
    mov.r R5, R3[I7]
    add I8, I7, 1
    mov I9, R2[I8]
    mov I10, R3[I8]
    call rt$compare (I9, I10, 1, R4, R5) -> I11
    bnz I11, 3b
    add I7, 4
    jmp 4b
5:  mov I7, 2
6:  bge I7, I5, eq
    mov.r R4, R2[I7]
    mov.r R5, R3[I7]
    add I8, I7, 1
    mov I9, R2[I8]
    mov I10, R3[I8]
    call rt$compare (I9, I10, exact, R4, R5) -> I11
    bnz I11, 3b
    add I7, 4
    jmp 6b
Llist:
    ; heads, then the tails (iteratively)
    mov I9, ar->Cons.hi
    mov.r R4, ar->Cons.hr
    mov I10, br->Cons.hi
    mov.r R5, br->Cons.hr
    call rt$compare (I9, I10, exact, R4, R5) -> I11
    bnz I11, 3b
    mov a, ar->Cons.ti
    mov.r ar, ar->Cons.tr
    mov b, br->Cons.ti
    mov.r br, br->Cons.tr
    bnisa ar, Cons, 7f
    bnisa br, Cons, 7f
    jmp Llist
7:  tcall rt$compare (a, b, exact, ar, br)
Lbin:
    tcall rt$cmpbin (ar, br)
.endf

.func rt$cmpnum(i64 a, i64 b, i64 exact, ref ar, ref br) -> i64
    bnz ar, 1f
    bnz br, 1f
    blt a, b, lt
    bgt a, b, gt
    ret 0
lt: ret -1
gt: ret 1
1:  call rt$numkind (ar) -> I3
    call rt$numkind (br) -> I4
    beq I3, 2, 2f
    beq I4, 2, 2f
    call rt$tobig (a, ar) -> R2
    call rt$tobig (b, br) -> R3
    blt.big R2, R3, lt
    bgt.big R2, R3, gt
    ret 0
2:  call rt$tof (a, ar) -> F0
    call rt$tof (b, br) -> F1
    blt F0, F1, lt
    bgt F0, F1, gt
    bz exact, 3f
    ; numerically equal, but exact: an integer before a float, floats by their bits
    bne I3, I4, 4f
    beq a, b, 3f
    blt a, b, lt
    jmp gt
4:  beq I3, 2, gt
    jmp lt
3:  ret 0
.endf

; Binaries, byte by byte, then by length.
.func rt$cmpbin(ref a, ref b) -> i64
    mov.r R2, a->Bin.data
    mov.r R3, b->Bin.data
    mov I0, a->Bin.off
    mov I1, b->Bin.off
    mov I2, a->Bin.len
    mov I3, b->Bin.len
    min I4, I2, I3
    mov I5, 0
1:  bge I5, I4, 2f
    add I6, I0, I5
    add I7, I1, I5
    mov.u8 I8, R2[I6]
    mov.u8 I9, R3[I7]
    blt I8, I9, lt
    bgt I8, I9, gt
    inc I5
    jmp 1b
2:  blt I2, I3, lt
    bgt I2, I3, gt
    ret 0
lt: ret -1
gt: ret 1
.endf

.func rt$cmp(i64 a, i64 b, ref ar, ref br) -> i64
    tcall rt$compare (a, b, 0, ar, br)
.endf

.func rt$eqx(i64 a, i64 b, ref ar, ref br) -> i64
    call rt$compare (a, b, 1, ar, br) -> I2
    seq I3, I2, 0
    ret I3
.endf

.func rt$eq(i64 a, i64 b, ref ar, ref br) -> i64
