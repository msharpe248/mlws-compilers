; does not kill the process for it.
.func rt$proc_start -> (i64, ref)
    mov.r R0, @g$start
    mov.r @g$start, null
    tcalli R0 ()
.endf

; The exit reason of an exception: exit's reason, {Reason, Stack} for an
; error, {{nocatch, Reason}, Stack} for a throw.
.func rt$exit_reason(i64 ri, ref cls, ref rr, ref stk) -> (i64, ref)
