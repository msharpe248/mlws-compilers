    tostr R1, F0
    ret 0, R1
.endf

; A float in C's %.Nf (kind 0) or %.Ne (kind 1) form, as an atom-like value.
.func rt$fmt_float(i64 a, i64 prec, i64 kind, ref ar, ref pr, ref kr) -> (i64, ref)
