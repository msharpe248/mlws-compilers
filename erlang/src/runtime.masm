; The body of every process: run the fun; if it fails, end with an Error
; whose message is the exit reason, written as a term.
.func rt$proc_entry(ref f)
    mov.r R1, f->Fun.clo
    mov.r @g$start, R1
    mov.r f, null
    mov.r R1, null
.try 1f
    call rt$proc_start () -> (I0, R0)
.endtry
    ret
1:  catch R2
    call rt$exc_info (R2) -> (I3, R3, R4, R5)
    call rt$exit_reason (I3, R3, R4, R5) -> (I6, R6)
    beq.r R6, "normal", 2f
    call E$erts$report$2 (0, I6, R3, R6) -> (I7, R7)
    call E$erts$ser$1 (I6, R6) -> (I7, R7)
    new R8, Error
    mov.r R8->Error.code, "E_ERLANG"
    mov.r R8->Error.message, R7
    throw R8
2:  ret
.endf

