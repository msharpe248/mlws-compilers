    bgt.big R5, 9223372036854775807n, 6f
    cvt.i64.big v, R5
    jmp 1f
5:  add.big R5, R5, 18446744073709551616n
6:  sub.big R5, R5, 18446744073709551616n
    cvt.i64.big v, R5
1:  and I6, flags, 2
    bnz I6, 3f
