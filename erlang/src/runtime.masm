9:  tcall rt$badarg ()
.endf

.func rt$processes -> (i64, ref)
    call rt$self () -> (I0, R0)
    new R1, Cons
    mov.r R1->Cons.hr, R0
    mov.r R1->Cons.tr, 0d
    ret 0, R1
.endf

; A line of standard input, as a list of characters with its newline; eof at the end.
.func rt$get_line -> (i64, ref)
    ncall "fs.stdin" () -> R0
    ncall "fs.read_line" (R0) -> R1
    bz R1, 1f
    strcat R2, R1, "\n"
    tcall rt$str_to_list (R2)
1:  ret 0, "eof"
.endf

; Chardata as a binary, UTF-8.
.func rt$utf8_bin(i64 a, ref l) -> (i64, ref)
    bufnew R1, 0
    call rt$iobuf (R1, a, l, 0) -> I1
    bz I1, 9f
    call rt$bin_of (R1) -> R2
    ret 0, R2
9:  tcall rt$badarg ()
.endf

; math: 0 sqrt, 1 sin, 2 cos, 3 tan, 4 asin, 5 acos, 6 atan, 7 exp, 8 log, 9 log2, 10 log10
.func rt$fmath(i64 k, i64 x, ref kr, ref xr) -> (i64, ref)
    call rt$numkind (xr) -> I2
    bge I2, 3, 9f
    call rt$tof (x, xr) -> F0
    jtab k, 0f, 1f, 2f, 3f, 4f, 5f, 6f, 7f, 8f, 10f, 11f
9:  tcall rt$badarith ()
0:  blt F0, 0.0, 9b
    sqrt F1, F0
    tcall rt$fres (F1)
1:  ncall "math.sin" (F0) -> F1
    tcall rt$fres (F1)
2:  ncall "math.cos" (F0) -> F1
    tcall rt$fres (F1)
3:  ncall "math.tan" (F0) -> F1
    tcall rt$fres (F1)
4:  ncall "math.asin" (F0) -> F1
    tcall rt$fres (F1)
5:  ncall "math.acos" (F0) -> F1
    tcall rt$fres (F1)
6:  ncall "math.atan" (F0) -> F1
    tcall rt$fres (F1)
7:  ncall "math.exp" (F0) -> F1
    tcall rt$fres (F1)
8:  ble F0, 0.0, 9b
    ncall "math.log" (F0) -> F1
    tcall rt$fres (F1)
10: ble F0, 0.0, 9b
    ncall "math.log2" (F0) -> F1
    tcall rt$fres (F1)
11: ble F0, 0.0, 9b
    ncall "math.log10" (F0) -> F1
    tcall rt$fres (F1)
.endf

; 0 pow, 1 atan2, 2 fmod
.func rt$fmath2(i64 k, i64 x, i64 y, ref kr, ref xr, ref yr) -> (i64, ref)
    call rt$numkind (xr) -> I3
    bge I3, 3, 9f
    call rt$numkind (yr) -> I3
    bge I3, 3, 9f
    call rt$tof (x, xr) -> F0
    call rt$tof (y, yr) -> F1
    jtab k, 0f, 1f, 2f
9:  tcall rt$badarith ()
0:  ncall "math.pow" (F0, F1) -> F2
    tcall rt$fres (F2)
1:  ncall "math.atan2" (F0, F1) -> F2
    tcall rt$fres (F2)
2:  beq F1, 0.0, 9b
    rem F2, F0, F1
    tcall rt$fres (F2)
.endf



; ---------------------------------------------------------------- file

; A file name (a string, a binary or an atom) as a string.
.func rt$filename(i64 a, ref n) -> (i64, ref)
    typeof I1, n
    bne I1, 1, 1f
    ret 0, n
1:  bnisa n, Bin, 2f
    tcall rt$bin_str (a, n)
2:  tcall rt$list_to_str (a, n)
.endf

; file:read_file(Name): {ok, Binary}, or {error, Why}.
.func rt$file_read(i64 a, ref n) -> (i64, ref)
    call rt$filename (a, n) -> (I1, R1)
.try 8f
    ncall "fs.read_file" (R1) -> R2
.endtry
    call rt$bin_of (R2) -> R3
    lnew R4, 4
    lpush R4, "ok", 0
    lpush R4, R3, 0
    ret 0, R4
8:  catch R5
    tcall rt$file_error (R5)
.endf

; file:write_file(Name, Data): ok, or {error, Why}.
.func rt$file_write(i64 a, i64 d, ref n, ref dr) -> (i64, ref)
    call rt$filename (a, n) -> (I4, R4)
    bufnew R2, 0
    call rt$iobuf (R2, d, dr, 0) -> I3
    bz I3, 9f
.try 8f
    ncall "fs.write_file" (R4, R2)
.endtry
    ret 0, "ok"
8:  catch R5
    tcall rt$file_error (R5)
9:  tcall rt$badarg ()
.endf

; {error, Why} for an OS error, as file says it.
.func rt$file_error(ref e) -> (i64, ref)
    mov.r R1, "eio"
    bnisa e, Error, 9f
    mov.r R2, e->Error.code
    strcmp I0, R2, "E_NOT_FOUND"
    bnz I0, 1f
    mov.r R1, "enoent"
1:  strcmp I0, R2, "E_PERMISSION"
    bnz I0, 2f
    mov.r R1, "eacces"
2:  strcmp I0, R2, "E_IS_DIR"
    bnz I0, 3f
    mov.r R1, "eisdir"
3:  strcmp I0, R2, "E_NOT_DIR"
    bnz I0, 9f
    mov.r R1, "enotdir"
9:  lnew R3, 4
    lpush R3, "error", 0
    lpush R3, R1, 0
    ret 0, R3
.endf
