2:  ret 0, R2
9:  tcall rt$badarg ()
.endf

; ---------------------------------------------------------------- strings and atoms

; The characters of a string (UTF-8), as a list.
.func rt$str_to_list(ref s) -> (i64, ref)
    ncall "text.chars" (s) -> R1
    len I0, R1
    mov.r R2, 0d
1:  dec I0
    blt I0, 0, 2f
    mov I1, R1[I0]
    new R3, Cons
    mov R3->Cons.hi, I1
    mov.r R3->Cons.tr, R2
    mov.r R2, R3
    jmp 1b
2:  ret 0, R2
.endf

; The bytes of a string, as a list.
.func rt$bytes_to_list(ref s, i64 off, i64 n) -> (i64, ref)
    mov.r R2, 0d
    add I2, off, n
1:  dec I2
    blt I2, off, 2f
    mov.u8 I3, s[I2]
    new R3, Cons
    mov R3->Cons.hi, I3
    mov.r R3->Cons.tr, R2
    mov.r R2, R3
    jmp 1b
2:  ret 0, R2
.endf

; Append a code point to a byte buffer, as UTF-8.
.func rt$pututf8(ref b, i64 c)
    bge c, 128, 1f
    bufpush b, c
    ret
1:  bge c, 2048, 2f
    sar I1, c, 6
    or I1, 192
    and I2, c, 63
    or I2, 128
    bufpush b, I1, I2
    ret
2:  bge c, 65536, 3f
    sar I1, c, 12
    or I1, 224
    sar I2, c, 6
    and I2, 63
    or I2, 128
    and I3, c, 63
    or I3, 128
    bufpush b, I1, I2, I3
    ret
3:  sar I1, c, 18
    or I1, 240
    sar I2, c, 12
    and I2, 63
    or I2, 128
    sar I3, c, 6
    and I3, 63
    or I3, 128
    and I4, c, 63
    or I4, 128
    bufpush b, I1, I2, I3, I4
    ret
.endf

; Append chardata or iodata (bytes=1: integers must be bytes) to a buffer.
; 0 if it is not that.
.func rt$iobuf(ref buf, i64 x, ref xr, i64 bytes) -> i64
1:  beq.r xr, 0d, ok
    bz xr, int
    bisa xr, Bin, bin
    bnisa xr, Cons, bad
    ; a list: its head, then its tail
    mov I2, xr->Cons.hi
    mov.r R2, xr->Cons.hr
    call rt$iobuf (buf, I2, R2, bytes) -> I3
    bz I3, bad
    mov x, xr->Cons.ti
    mov.r xr, xr->Cons.tr
    jmp 1b
int:
    blt x, 0, bad
    bz bytes, 2f
    bgt x, 255, bad
    bufpush buf, x
    ret 1
2:  bgt x, 1114111, bad
    call rt$pututf8 (buf, x)
    ret 1
bin:
    mov.r R3, xr->Bin.data
    mov I4, xr->Bin.off
    mov I5, xr->Bin.len
    add I5, I4
3:  bge I4, I5, ok
    mov.u8 I6, R3[I4]
    bufpush buf, I6
    inc I4
    jmp 3b
ok: ret 1
bad:
    ret 0
.endf

; Chardata as a string (an atom-like value, not interned): for natives.
.func rt$list_to_str(i64 x, ref l) -> (i64, ref)
    bufnew R1, 0
    call rt$iobuf (R1, x, l, 0) -> I1
    bz I1, 9f
    strcat R2, R1
    ret 0, R2
9:  tcall rt$badarg ()
.endf

.func rt$atom_to_list(i64 a, ref s) -> (i64, ref)
    typeof I1, s
    bne I1, 1, 9f
    tcall rt$str_to_list (s)
9:  tcall rt$badarg ()
.endf

; The atom with a name: the program's literal one if there is one. (erlrt's
; is text.intern, in runtime_mod.masm.)
.func rt$intern_table(ref s) -> (i64, ref)
    mov.r R1, @g$atomtab
    bnz R1, 1f
    call rt$atoms_init () -> R1
    mov.r @g$atomtab, R1
1:  mget.r R2, R1, s, null
    bz R2, 2f
    ret 0, R2
2:  mset R1, s, s
    ret 0, s
.endf

.func rt$list_to_atom(i64 a, ref l) -> (i64, ref)
    call rt$list_to_str (a, l) -> (I1, R1)
    tcall rt$intern (R1)
.endf

.func rt$integer_to_list(i64 a, ref ar) -> (i64, ref)
    call rt$numkind (ar) -> I1
    bge I1, 2, 9f
    bnz I1, 1f
    tostr R1, a
    tcall rt$str_to_list (R1)
1:  tostr.big R1, ar
    tcall rt$str_to_list (R1)
9:  tcall rt$badarg ()
.endf

; A string of digits as an integer; badarg if it is not one.
.func rt$str_to_int(ref s) -> (i64, ref)
    len I0, s
    bz I0, 9f
    mov.u8 I1, s[0]
    bne I1, '+', 1f
    sub I0, 1
    substr s, s, 1, I0
1:  ; only digits after an optional sign
    mov I2, 0
    mov.u8 I1, s[0]
    bne I1, '-', 2f
    inc I2
2:  bge I2, I0, 3f
    mov.u8 I1, s[I2]
    blt I1, '0', 9f
    bgt I1, '9', 9f
    inc I2
    jmp 2b
3:  mov.u8 I1, s[0]
    bne I1, '-', 4f
