    bnz I2, 1f
    bisa pr, Pid, 1f
    tcall rt$badarg ()
1:  lnew R2, 2
    lpush R2, mr, m
    send I2, R2
    ret m, mr
.endf

.func rt$mbox_new -> ref
    new R0, Mbox
    lnew R1
    mov.r R0->Mbox.saved, R1
    mov.r @g$mbox, R0
    ret R0
.endf

; A receive's timeout: the time (ms, monotonic) it ends, or -1 for infinity.
.func rt$recv_deadline(i64 t, ref tr) -> i64
    beq.r tr, "infinity", 1f
    bnz tr, 9f
    blt t, 0, 9f
    ncall "time.monotonic" () -> I1
    div I1, 1000000
    add I1, t
    ret I1
1:  ret -1
9:  lnew R1, 4
    lpush R1, "timeout_value", 0, tr, t
    call rt$raise (0, "error", R1) -> (I0, R0)
    ret -1
.endf

; The next message a receive should look at: those saved first, then new
; ones. The receive passes back what this returned last (st = -1 the first
