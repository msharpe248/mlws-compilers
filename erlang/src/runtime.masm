; Append a segment: type (flags >> 2) 0 integer, 1 binary, 2 float, 3 utf8;
; flags & 1 signed, & 2 little-endian. size in bits (binary: bytes, -1 all).
.func rt$bin_put(i64 v, i64 size, i64 flags, ref b, ref vr, ref sr) -> (i64, ref)
