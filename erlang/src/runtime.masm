; the receive does not take it, and is kept in the receive's registers until
; then, not in the Mbox (a store the collector would have to remember).
; (0, ...) when the deadline passes.
.func rt$recv_next(i64 deadline, i64 st, i64 mi, ref mr) -> (i64, i64, ref)
    mov.r R7, mr            ; R0 and I2 are needed below
    mov I9, mi
    mov.r R0, @g$mbox
    bnz R0, 1f
    call rt$mbox_new () -> R0
1:  mov.r R6, R0->Mbox.saved
    bne st, 2, 2f
    lpush R6, R7, I9
    mov I2, R0->Mbox.scan
    inc I2
    mov R0->Mbox.scan, I2
    jmp 3f
2:  bne st, -1, 3f
    mov R0->Mbox.scan, 0
3:  len I1, R6
    mov I2, R0->Mbox.scan
    shl I3, I2, 1
    bge I3, I1, wait
    mov.r R1, R6[I3]
    add I4, I3, 1
    mov I5, R6[I4]
    inc I2
    mov R0->Mbox.scan, I2
    ret 1, I5, R1
wait:
    beq deadline, -1, inf
    ncall "time.monotonic" () -> I6
    div I6, 1000000
    sub I7, deadline, I6
    bge I7, 0, 2f
    mov I7, 0
2:  recvt R2, I7, timeout
    jmp got
inf:
