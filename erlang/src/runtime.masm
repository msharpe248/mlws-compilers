    beq.r cls, "error", 2f
    lnew R4, 4
    lpush R4, "nocatch", 0, rr, ri
    lnew R5, 4
    lpush R5, R4, 0, stk, 0
    ret 0, R5
1:  ret ri, rr
2:  lnew R5, 4
    lpush R5, rr, ri, stk, 0
    ret 0, R5
.endf

.func rt$spawn_check(ref f)
