    bgt i, I2, 9f
    shl I3, i, 1
    sub I3, 2
    mov.r R2, tr[I3]
    inc I3
    mov I4, tr[I3]
    ret I4, R2
9:  tcall rt$badarg ()
.endf

.func rt$setelement(i64 i, i64 t, i64 v, ref ir, ref tr, ref vr) -> (i64, ref)
