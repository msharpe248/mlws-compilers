    call rt$tsize (tr) -> I3
    blt i, 1, 9f
    bgt i, I3, 9f
    shl I4, I3, 1
    lnew R3, I4
    shl I5, i, 1
    sub I5, 2
    mov I6, 0
1:  bge I6, I4, 3f
    beq I6, I5, 2f
    mov.r R4, tr[I6]
    add I7, I6, 1
    mov I8, tr[I7]
