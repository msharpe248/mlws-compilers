; ---------------------------------------------------------------- funs and apply

; apply(Fun, Args)
.func rt$apply_fun(i64 f, i64 a, ref fr, ref ar) -> (i64, ref)
    bnisa fr, Fun, bad
    call rt$length (a, ar) -> (I2, R2)
    mov I3, fr->Fun.arity
    bne I2, I3, bad
    mov.r R9, fr->Fun.clo
    mov.r R8, ar
    .irp k, 10, 11, 12, 13, 14, 15, 16, 17
    beq.r R8, 0d, 1f
    mov I\k, R8->Cons.hi
    mov.r R\k, R8->Cons.hr
    mov.r R8, R8->Cons.tr
    .endr
1:  jtab I2, c0, c1, c2, c3, c4, c5, c6, c7, c8
bad:
    tcall rt$badfun (f, a, fr, ar)
c0: tcalli R9 ()
c1: tcalli R9 (I10, R10)
c2: tcalli R9 (I10, I11, R10, R11)
c3: tcalli R9 (I10, I11, I12, R10, R11, R12)
c4: tcalli R9 (I10, I11, I12, I13, R10, R11, R12, R13)
c5: tcalli R9 (I10, I11, I12, I13, I14, R10, R11, R12, R13, R14)
c6: tcalli R9 (I10, I11, I12, I13, I14, I15, R10, R11, R12, R13, R14, R15)
c7: tcalli R9 (I10, I11, I12, I13, I14, I15, I16, R10, R11, R12, R13, R14, R15, R16)
c8: tcalli R9 (I10, I11, I12, I13, I14, I15, I16, I17, R10, R11, R12, R13, R14, R15, R16, R17)
.endf

; apply(M, F, Args), M:F(...): through the table of exported functions
.func rt$apply(i64 m, i64 f, i64 a, ref mr, ref fr, ref ar) -> (i64, ref)
    typeof I3, mr
    bne I3, 1, bad
    typeof I3, fr
    bne I3, 1, bad
    call rt$length (a, ar) -> (I4, R4)
    tostr R5, I4
    strcat R6, mr, ":", fr, "/", R5
    mov.r R7, @g$dispatch
    bnz R7, 1f
    call rt$dispatch_init () -> R7
    mov.r @g$dispatch, R7
