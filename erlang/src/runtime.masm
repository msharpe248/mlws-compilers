    mov.r l, l->Cons.tr
    jmp 1b
2:  ret I1, null
9:  tcall rt$badarg ()
.endf

; lists:reverse(L, Tail)
.func rt$reverse(i64 a, i64 t, ref l, ref tr) -> (i64, ref)
1:  beq.r l, 0d, 2f
    bnisa l, Cons, 9f
    new R2, Cons
    mov I3, l->Cons.hi
    mov.r R3, l->Cons.hr
    mov R2->Cons.hi, I3
    mov.r R2->Cons.hr, R3
    mov R2->Cons.ti, t
    mov.r R2->Cons.tr, tr
    mov t, 0
    mov.r tr, R2
    mov.r l, l->Cons.tr
    jmp 1b
2:  ret t, tr
9:  tcall rt$badarg ()
.endf

; Is it a tuple? Its size in I, or -1.
.func rt$tsize(ref t) -> i64
