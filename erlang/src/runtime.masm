    mov R0->Pid.id, id
    ret R0
.endf

.func rt$self -> (i64, ref)
    mov.r R0, @g$self
    bnz R0, 1f
    call rt$pid (PID) -> R0
    mov.r @g$self, R0
1:  ret 0, R0
.endf

; The id of a pid, or of a registered name; 0 if there is none.
.func rt$pid_id(ref p) -> i64
    bnisa p, Pid, 1f
    mov I0, p->Pid.id
    ret I0
1:  typeof I0, p
    bne I0, 1, 2f
    ncall "proc.whereis" (p) -> I0
    ret I0
2:  ret 0
.endf

; Pid ! Msg: messages travel as a list [R, I].
.func rt$send(i64 p, i64 m, ref pr, ref mr) -> (i64, ref)
