; ---------------------------------------------------------------- lists and tuples

; A ++ B
.func rt$append(i64 a, i64 b, ref ar, ref br) -> (i64, ref)
    beq.r ar, 0d, 9f
    bnisa ar, Cons, 8f
    new R2, Cons
    mov I6, ar->Cons.hi
    mov.r R6, ar->Cons.hr
    mov R2->Cons.hi, I6
    mov.r R2->Cons.hr, R6
    mov.r R3, R2
    mov.r R4, ar->Cons.tr
1:  beq.r R4, 0d, 2f
    bnisa R4, Cons, 8f
    new R5, Cons
    mov I6, R4->Cons.hi
    mov.r R6, R4->Cons.hr
    mov R5->Cons.hi, I6
    mov.r R5->Cons.hr, R6
    mov.r R3->Cons.tr, R5
    mov.r R3, R5
    mov.r R4, R4->Cons.tr
    jmp 1b
2:  mov R3->Cons.ti, b
    mov.r R3->Cons.tr, br
    ret 0, R2
9:  ret b, br
8:  tcall rt$badarg ()
.endf

.func rt$length(i64 a, ref l) -> (i64, ref)
