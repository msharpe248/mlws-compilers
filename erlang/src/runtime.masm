    mov I7, I4
2:  bz I7, done
    dec I7
    shl I8, I7, 3
    mov I9, 0
    bge I8, 64, 4f
    sar I9, v, I8
4:  and I9, 255
    bufpush R3, I9
    jmp 2b
3:  mov I7, 0
7:  bge I7, I4, done
    shl I8, I7, 3
    mov I9, 0
    bge I8, 64, 8f
    sar I9, v, I8
8:  and I9, 255
    bufpush R3, I9
    inc I7
    jmp 7b
bin:
