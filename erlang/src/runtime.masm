    ret 0, 0, null
.endf

; Take the saved message the receive matched.
.func rt$recv_accept
    mov.r R0, @g$mbox
    mov.r R2, R0->Mbox.saved
    mov I0, R0->Mbox.scan
    dec I0
    shl I0, I0, 1
    ldel R2, I0
    ldel R2, I0
    ret
.endf

; A Down from the VM as an Erlang message: {'DOWN', Ref, process, Pid,
; Reason} for a monitor, {'EXIT', Pid, Reason} for a link while trapping
; exits. (0, ...) if nobody asked for it.
.func rt$down_msg(ref d) -> (i64, i64, ref)
    mov I0, d->Down.pid
    call rt$pid (I0) -> R1
    call rt$down_reason (d) -> (I1, R2)
    mov.r R3, @g$monitors
    bz R3, 1f
    mget.r R4, R3, I0, null
    bz R4, 1f
    mdel R3, I0
    lnew R5, 10
    lpush R5, "DOWN", 0, R4, 0, "process", 0, R1, 0, R2, I1
    ret 1, 0, R5
1:  mov.r R3, @g$links
    bz R3, 2f
    mhas I2, R3, I0
    bz I2, 2f
    mdel R3, I0
    lnew R5, 6
    lpush R5, "EXIT", 0, R1, 0, R2, I1
    ret 1, 0, R5
2:  ret 0, 0, null
.endf

; Why a process ended, from its Down.
.func rt$down_reason(ref d) -> (i64, ref)
    mov.r R1, d->Down.code
    bnz R1, 1f
    ret 0, "normal"
1:  strcmp I0, R1, "E_ERLANG"
    bnz I0, 2f
    mov.r R2, d->Down.message
    call E$erts$deser$1 (0, R2) -> (I1, R3)
    ret I1, R3
2:  call rt$vm_reason (R1) -> (I1, R3, R4)
    ret I1, R3
