    ret 0, b
9:  tcall rt$badarg ()
.endf

; Read a segment at byte offset off: (ok, value I, next offset, value R).
.func rt$bin_get(i64 off, i64 size, i64 unit, i64 flags, ref b, ref sr) -> (i64, i64, i64, ref)
