; The runtime's part for a program compiled with --modules (MLWSVM 0.18.0's
; module.* natives): only erlrt has it.
; ---------------------------------------------------------------- --modules

; M:F/N of a program's module (compiled with --modules): the closure for
; its current version, loading the module if need be. fname is its MLWSVM
; name. A module or function that is not there: error undef.
.func rt$rfun(i64 n, ref m, ref f, ref fname) -> ref
.try 8f
    ncall "module.load" (m)
    ncall "module.function" (m, fname) -> (R4)
.endtry
    ret R4
8:  catch R5
    call rt$undef (0, 0, n, m, f, null) -> (I6, R6)
    ret null
.endf

; code:load_file(M): load M, or a new version of it, from its file: ok, or
; why not.
.func rt$code_load(i64 mi, ref m) -> (i64, ref)
    call rt$split -> I1
    bz I1, 7f
    ncall "module.loaded" (m) -> (I2)
    bnz I2, 1f
.try 8f
    ncall "module.load" (m)
.endtry
    ret 0, "ok"
1:
.try 8f
    ncall "module.reload" (m)
.endtry
    ret 0, "ok"
7:  ret 0, "embedded"
8:  catch R3
    tcall rt$code_why (R3)
.endf

; code:load_binary(M, File, Bin): a new version of M from its assembly.
.func rt$code_load_text(i64 mi, i64 bi, ref m, ref b) -> (i64, ref)
    call rt$split -> I1
    bz I1, 7f
    call rt$bin_str (bi, b) -> (I2, R2)
.try 8f
    ncall "module.loaded" (m) -> (I3)
    bnz I3, 1f
    ncall "module.load" (m)
1:  ncall "module.reload_text" (m, R2)
.endtry
    ret 0, "ok"
7:  ret 0, "embedded"
8:  catch R3
    tcall rt$code_why (R3)
.endf

; Why a load failed, as code says it.
.func rt$code_why(ref e) -> (i64, ref)
    bnisa e, Error, 9f
    strcmp I0, e->Error.code, "E_LOAD_NOT_FOUND"
    bz I0, 1f
9:  ret 0, "badfile"
1:  ret 0, "nofile"
.endf

; code:purge(M): true if it killed a process still running old code.
.func rt$code_purge(i64 mi, ref m) -> (i64, ref)
    call rt$split -> I1
    bz I1, 7f
.try 8f
    ncall "module.purge_kill" (m) -> (I2, I3, I4)
.endtry
    bz I4, 7f
    ret 0, "true"
7:  ret 0, "false"
8:  catch R5
    ret 0, "false"
.endf

; code:soft_purge(M): false if a process still runs M's old code.
.func rt$code_soft_purge(i64 mi, ref m) -> (i64, ref)
    call rt$split -> I1
    bz I1, 6f
.try 8f
    ncall "module.purge" (m) -> (I2, I3)
.endtry
    bnz I3, 7f
6:  ret 0, "true"
7:  ret 0, "false"
8:  catch R5
    ret 0, "true"
.endf

.func rt$code_loaded(i64 mi, ref m) -> (i64, ref)
    call rt$split -> I1
    bz I1, 7f
    ncall "module.loaded" (m) -> (I2)
    bz I2, 7f
    ret 0, "true"
7:  ret 0, "false"
.endf
