#!/bin/sh
# Compile an Erlang program with mlws-vm-erlc and run it on MLWSVM.
#
#   mlws-vm-erl [options] program.erl [args...]
#     -S           only compile: write the assembly (.masm) and do not run it
#     -k           keep the assembly after running it
#     -g           name the program's variables for MLWSVM's debuggers
#                  (mlwsvm debug, mlwsvm dap; MLWSVM 0.17.3 or later)
#     -d           run the program in MLWSVM's debugger (mlwsvm debug),
#                  which reads its commands from standard input; implies -g;
#                  the code runs as compiled (MLWSVM_OPT=0: the optimizer
#                  would drop the names)
#     -o FILE      the assembly file (default: program.masm next to the
#                  source); with -S, '-' writes it to standard output
#     -b FILE, --bundle FILE
#                  write one executable, FILE, holding the VM and the
#                  program (optimized at --opt 3, the JIT on) instead of
#                  running it; it runs with no MLWSVM beside it (MLWSVM
#                  0.17.0 or later)
#     --modules DIR
#                  compile each module to DIR as an MLWSVM module of its own
#                  (M.masm, and erlrt.masm, the runtime and library), and run
#                  the program from there: code:load_file can then replace a
#                  module while it runs (MLWSVM 0.18.0 or later); with -S,
#                  only compile
#     --env FILE   fill the program's environment (application:get_env)
#                  from FILE, lines of `app.key = JSON` (mlwsvm run --env);
#                  may be given more than once
#     --version    print the compiler's version
#
# The program's main/0 runs (or main/1, given the arguments as strings).
# Other modules it calls are found as NAME.erl next to it.
# The VM is found as $MLWSVM, then mlwsvm on PATH, then ../mlws-vm/mlwsvm
# next to this repository.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
usage() {
    echo "usage: mlws-vm-erl [--version] [-g] [-d | -b FILE] [-S | -k] [-o FILE | --modules DIR] [--env FILE]... program.erl [args...]" >&2
    exit 64
}

compile_only= keep= out= prog= bundle= debug= g= moddir= envs=
while [ $# -gt 0 ]; do
    case "$1" in
        -S) compile_only=1; shift ;;
        -k) keep=1; shift ;;
        -g) g=-g; shift ;;
        -d) debug=1; g=-g; shift ;;
        -b|--bundle) [ $# -ge 2 ] || usage; bundle=$2; shift 2 ;;
        -o) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
        --modules) [ $# -ge 2 ] || usage; moddir=$2; shift 2 ;;
        --env) [ $# -ge 2 ] || usage
               case $2 in *[\ \	]*) echo "mlws-vm-erl: --env: no spaces in the path, please" >&2; exit 64 ;; esac
               envs="$envs --env $2"; shift 2 ;;
        --version) exec "$here/mlws-vm-erlc" --version ;;
        -h|--help) usage ;;
        -*) usage ;;
        *) prog=$1; shift; break ;;
    esac
done
[ -n "$prog" ] || usage
[ -z "$bundle" ] || { [ $# -eq 0 ] && [ -z "$compile_only" ]; } || usage
[ -z "$debug" ] || { [ $# -eq 0 ] && [ -z "$compile_only" ] && [ -z "$bundle" ]; } || usage
if [ -n "$moddir" ]; then
    { [ -z "$bundle" ] && [ -z "$debug" ] && [ -z "$keep" ] && [ -z "$out" ]; } || usage
    mkdir -p "$moddir" && "$here/mlws-vm-erlc" $g --modules "$moddir" "$prog" || exit $?
    [ -n "$compile_only" ] && exit 0
    . "$here/../tools/find-vm.sh"
    name=$(basename -- "$prog"); name=${name%.erl}
    exec "$MLWSVM" run $envs --max-frames 50000000 "$moddir/$name.masm" "$@"
fi

if [ -n "$compile_only" ] || [ -n "$keep" ] || [ -n "$out" ]; then
    [ -n "$out" ] || out="${prog%.*}.masm"
    if [ "$out" = "-" ] && [ -z "$compile_only" ]; then
        echo "mlws-vm-erl: -o - (standard output) needs -S" >&2
        exit 64
    fi
else
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/erl.XXXXXX") || exit 1
    trap 'rm -rf "$tmp"' EXIT INT TERM
    out="$tmp/program.masm"
fi
"$here/mlws-vm-erlc" $g -o "$out" "$prog" || exit $?
[ -n "$compile_only" ] && exit 0

. "$here/../tools/find-vm.sh"
# Erlang recurses deeply (lists:map on a long list): allow many frames.
if [ -n "$bundle" ]; then
    "$MLWSVM" bundle $envs -o "$bundle" --opt 3 --jit on --max-frames 50000000 "$out"
    exit $?
fi
if [ -n "$debug" ]; then
    MLWSVM_OPT=0 "$MLWSVM" debug $envs --max-frames 50000000 "$out"
    exit $?
fi
"$MLWSVM" run $envs --max-frames 50000000 "$out" "$@"
